+
+# The cache arm, after every other arm, since an environment runs on a managed
+# interpreter that the interpreter arm may just have restored. An environment
+# with its pyvenv.cfg and a running interpreter is reinstalled in place, every
+# distribution at the version, or from the source, its dist-info records, from
+# / and with no cache, so it never builds from a damaged wheel, a process
+# running from it keeps importing, and the calls waiting on the lock find it
+# whole and rebuild nothing. The rest are removed for uv to rebuild from the
+# script or spec the next call names: a cached environment's link, which
+# leaves the archive a running process may be using; a script environment
+# without pyvenv.cfg or interpreter, renamed aside before any uv call could
+# take uv to the base interpreter in its place; and an unpacked wheel, by its
+# archive pointer and its link, so the next build fetches it again.
+uvm_repair_cache() {
+  local entry kind p out line aside f fix=() drop=() pins=() di
+  for entry in ${uvm_cache_drop[@]+"${uvm_cache_drop[@]}"}; do drop+=("${entry}"); done
+  for entry in ${uvm_cache_fix[@]+"${uvm_cache_fix[@]}"}; do
+    kind="${entry%%:*}" p="${entry#*:}"
+    if [[ ! -f "${p}/pyvenv.cfg" || ! -x "${p}/bin/python" ]]; then drop+=("${entry}"); continue; fi
+    if [[ "${kind}" == link ]]; then
+      for di in "${p}"/lib/*/site-packages/*.dist-info; do
+        if [[ -e "${di}/direct_url.json" ]]; then drop+=("${entry}"); continue 2; fi
+      done
+    fi
+    fix+=("${entry}")
+  done
+  (( ${#fix[@]} + ${#drop[@]} > 0 )) || return 0
+  note "repairing the cache for ${arch}: ${#fix[@]} environment(s) in place, ${#drop[@]} entry(ies) removed"
+  for entry in ${drop[@]+"${drop[@]}"}; do
+    kind="${entry%%:*}" p="${entry#*:}"
+    case "${kind}" in
+      script)
+        aside="${p%/*}/.${p##*/}.$(uname -n).$$.${RANDOM}"
+        if ! out=$(mv -- "${p}" "${aside}" 2>&1); then
+          uvm_repair_reason="cannot remove the cache entry ${p}: ${out}"
+          return 0
+        fi
+        rm -rf -- "${aside}" 2>/dev/null || note "left ${aside} behind; uv cache prune removes it"
+        ;;
+      wheel)
+        # uv finds the archive through a pointer beside the link, not the
+        # link itself; every sibling but uv's lock file goes, then the link.
+        out=""
+        for f in "${p}".*; do
+          [[ -e "${f}" && "${f}" != *.lock ]] || continue
+          out+="$(rm -f -- "${f}" 2>&1)" || break
+        done
+        if [[ -n "${out}" ]] || ! out=$(rm -f -- "${p}" 2>&1); then
+          uvm_repair_reason="cannot remove the cache entry ${p}: ${out}"
+          return 0
+        fi ;;
+      *)
+        if ! out=$(rm -f -- "${p}" 2>&1); then
+          uvm_repair_reason="cannot remove the cache entry ${p}: ${out}"
+          return 0
+        fi ;;
+    esac
+  done
+  for entry in ${fix[@]+"${fix[@]}"}; do
+    p="${entry#*:}" pins=()
+    if ! out=$(uvm_record_constraints "${p}"); then
+      uvm_repair_reason="the cache environment ${p} holds a distribution whose source is not recorded"
       return 0
     fi
-    if ! (cd / && exec "${real_uv}" pip install --python "${uvm_root}/tools/${tool}/bin/python" \
-         --reinstall --no-cache "${uvm_pins[@]}") >&2; then
-      uvm_repair_reason="the tool environment repair failed for ${tool}"
+    while IFS= read -r line; do [[ -z "${line}" ]] || pins+=("${line}"); done <<< "${out}"
+    (( ${#pins[@]} > 0 )) || continue
+    if ! (cd / && exec "${real_uv}" pip install --python "${p}/bin/python" --reinstall --no-cache "${pins[@]}") >&2; then
+      uvm_repair_reason="the cache environment repair failed for ${p}"
       return 0
     fi
   done
-  return 0
