+# ---- uv's cache --------------------------------------------------------------
+#
+# The live entries of uv's cache, the ones a uv run or uvx call executes or
+# builds from: a script environment, a real directory under environments-v2;
+# a cached environment (uvx, uv run --with), a link under environments-v2/<hash>
+# into archive-v0; an unpacked wheel, a link under wheels-v* into archive-v0.
+# An archive no link reaches is not walked: uv cache prune collects it. A link
+# is walked through, so no readlink forks. Sets uvm_cache_findings and
+# uvm_cache_problems, and for the repair uvm_cache_fix (environments the
+# repair reinstalls in place) and uvm_cache_drop (entries it removes, each
+# KIND:PATH with KIND script, link or wheel).
+uvm_cache_entry() {  # KIND PATH: check one live entry
+  local kind="$1" p="$2" di sp rel missing total why="" dists
+  if [[ "${kind}" != wheel && ! -f "${p}/pyvenv.cfg" ]]; then
+    why="it has no pyvenv.cfg"
+  else
+    if [[ "${kind}" == wheel ]]; then dists=("${p}"/*.dist-info); else dists=("${p}"/lib/*/site-packages/*.dist-info); fi
+    [[ "${kind}" != wheel || -d "${dists[0]}" ]] || why="it has no dist-info directory"
+    for di in "${dists[@]}"; do
+      [[ -z "${why}" && -d "${di}" ]] || continue
+      sp="${di%/*}"
+      if [[ ! -f "${di}/RECORD" ]]; then why="${di##*/} has no RECORD manifest"; break; fi
+      if [[ ! -f "${di}/METADATA" ]]; then why="${di##*/} has no METADATA"; break; fi
+      missing=0 total=0
+      while IFS=, read -r rel _ || [[ -n "${rel}" ]]; do
+        [[ -n "${rel}" ]] || continue
+        rel="${rel#\"}"; rel="${rel%\"}"
+        case "${rel}" in /*) continue ;; esac
+        total=$(( total + 1 ))
+        [[ -e "${sp}/${rel}" || -L "${sp}/${rel}" ]] || missing=$(( missing + 1 ))
+      done < "${di}/RECORD"
+      if (( missing > 0 )); then why="${di##*/} is missing ${missing} of ${total} files"; break; fi
+    done
+  fi
+  [[ -n "${why}" ]] || return 0
+  uvm_cache_findings+="FAIL  cache entry ${p} is damaged (${why}, partial purge)"$'\n'
+  uvm_cache_problems=$(( uvm_cache_problems + 1 ))
+  if [[ "${kind}" == wheel || "${why}" == "it has no pyvenv.cfg" ]]; then
+    uvm_cache_drop+=("${kind}:${p}")
+  else
+    uvm_cache_fix+=("${kind}:${p}")
+  fi
+}
