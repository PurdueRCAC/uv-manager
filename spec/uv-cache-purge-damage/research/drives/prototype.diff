+uvm_detect_cache() {
+  local cache="${uvm_root}/cache" e l
+  uvm_cache_findings="" uvm_cache_problems=0 uvm_cache_fix=() uvm_cache_drop=()
+  [[ -d "${cache}" ]] || return 0
+  for e in "${cache}"/environments-v2/*/; do
+    e="${e%/}"
+    [[ -d "${e}" && ! -L "${e}" ]] || continue
+    if [[ -e "${e}/pyvenv.cfg" || -d "${e}/lib" || -d "${e}/bin" ]]; then
+      uvm_cache_entry script "${e}"
+      continue
+    fi
+    for l in "${e}"/*; do
+      [[ -L "${l}" && -d "${l}" ]] || continue
+      uvm_cache_entry link "${l}"
+    done
+  done
+  # Wheels sit at a depth that depends on where they came from; find lists
+  # the links without following them into the archives. One fork per walk.
+  for e in "${cache}"/wheels-v*; do
+    [[ -d "${e}" ]] || continue
+    while IFS= read -r l; do
+      [[ -n "${l}" && -L "${l}" && -d "${l}" ]] || continue
+      uvm_cache_entry wheel "${l}"
+    done <<< "$(find "${e}" -type l 2>/dev/null)"
+  done
+}
