#!/usr/bin/env bash
#
# uv-manager — transparent, quota-safe, arch-aware launcher for `uv`/`uvx`
# on heterogeneous HPC clusters.
#
# This file is the real script. Deploy centrally, e.g.:
#   /apps/external/uv/main/bin/uv-manager        the script
#   /apps/external/uv/main/bin/{uv,uvx,uvm}      symlinks to it
# Do NOT put this at ~/.local/bin/uv — that's the standalone installer's
# default UV_INSTALL_DIR, and this would silently overwrite a user's own
# real uv binary if one is already there. Keep this path disjoint and make
# it opt-in (module load / explicit PATH addition), never default PATH.
#
# Real uv payload (binary, cache, tool venvs, managed pythons) never touches
# home quota — it lives under $UVM_ROOT/<arch>/ instead. What lives under
# home is $UVM_DATA: a record of each installed tool, a few KB apiece.
#
# See README.md for the design rationale.

set -euo pipefail

readonly uvm_version="0.7.0"

# ---- identity: uv, uvx or uv-manager, decided purely by argv[0] ------------
#
# Real uv does the same thing, so `uvx` needs no separate code path. Dispatch
# keys on the name used to invoke the script, not on whether that name is a
# symlink: a copy named `uvx` still runs in uvx mode.
#
# Anything not recognised falls through to uv mode.

prog="${0##*/}"
case "${prog}" in
  uvx)              mode="uvx"     ;;
  uv-manager|uvm)   mode="manager" ;;
  *)                mode="uv"      ;;
esac

# ---- diagnostics -----------------------------------------------------------

note() { printf 'uv-manager: %s\n' "$*" >&2; }
die()  { printf 'uv-manager: %s\n' "$*" >&2; exit 1; }

# Resolve a path to an absolute, symlink-free form without requiring GNU
# readlink -f or realpath (absent on some minimal images and on macOS).
abspath() {
  local p="$1" d b
  d="$(dirname -- "${p}")"
  b="$(basename -- "${p}")"
  # The empty CDPATH prefix is deliberate: with CDPATH set, `cd` prints the
  # directory it chose, which would end up in the output.
  # shellcheck disable=SC1007
  printf '%s/%s\n' "$(CDPATH= cd -- "${d}" 2>/dev/null && pwd -P)" "${b}"
}

# ---- state root ------------------------------------------------------------
#
# UVM_ROOT is the single knob a site is expected to set, normally from
# its modulefile, where it is visible in `module show uv` and in the user's
# environment. It is architecture-NEUTRAL on purpose: the arch component is
# appended here, at exec time, on the executing node, so a modulefile
# evaluated on an x86_64 login node can safely be inherited by an aarch64
# compute node via `sbatch --export=ALL`.
#
# The cascade below exists only for when the variable is absent — the module
# was not loaded and the wrapper was invoked by absolute path, which is the
# normal case for automation (a Globus Compute user endpoint, a systemd user
# unit, `sbatch --export=NONE`).
#
# There is no /tmp fallback. Node-local storage would turn a configuration
# problem into per-node re-downloads, a cold cache on every job, an egress
# requirement on every node, and environments that disappear at job end.

# Candidate bases, in order of preference. `.uv` is appended to the winner.
readonly uvm_candidates=(
  CLUSTER_SCRATCH   # Purdue RCAC
  RCAC_SCRATCH      # Purdue RCAC, community clusters
  SCRATCH           # Anvil, TACC, NERSC, many others
  PSCRATCH          # NERSC Perlmutter
  WORK              # TACC, Anvil (not purged — often the better choice)
  PROJECT           # Anvil
)

uvm_resolve_root() {
  if [[ -n "${UVM_ROOT:-}" ]]; then
    uvm_base="${UVM_ROOT}"
    uvm_base_origin="UVM_ROOT"
    return 0
  fi

  local name value
  for name in "${uvm_candidates[@]}"; do
    value="${!name:-}"
    [[ -n "${value}" ]] || continue
    [[ -d "${value}" && -w "${value}" ]] || continue
    uvm_base="${value}/.uv"
    uvm_base_origin="\$${name}"
    return 0
  done

  # Nothing resolved. Report every candidate tried and how to fix it.
  {
    printf 'uv-manager: cannot determine where to keep per-user uv state.\n\n'
    printf '  UVM_ROOT is unset, and none of these named an existing,\n'
    printf '  writable directory:\n\n'
    for name in "${uvm_candidates[@]}"; do
      value="${!name:-}"
      if [[ -z "${value}" ]]; then
        printf '      $%-16s (unset)\n' "${name}"
      elif [[ ! -d "${value}" ]]; then
        printf '      $%-16s %s (not a directory)\n' "${name}" "${value}"
      else
        printf '      $%-16s %s (not writable)\n' "${name}" "${value}"
      fi
    done
    printf '\n  Fix by loading the site module:\n'
    printf '      module load uv\n\n'
    printf '  or by setting it explicitly — for automation and batch contexts\n'
    printf '  that do not inherit a login shell, do this in the job script or\n'
    printf '  endpoint configuration:\n'
    printf '      export UVM_ROOT=/path/to/large/scratch/.uv\n\n'
    printf '  This must be on storage visible from every node that will run uv,\n'
    printf '  at the same path, and it must not be your home directory.\n'
  } >&2
  exit 1
}

uvm_base=""
uvm_base_origin=""

# ---- platform key ----------------------------------------------------------
#
# `uname -m` is the right granularity for the uv binary and for uv-managed
# CPython builds, and it is cheap. It runs on every invocation, including
# inside loops that call `uv run` thousands of times. Sites needing a finer
# split (glibc skew between login and compute images, musl, x86-64
# microarchitecture levels) should override it and keep it just as cheap.
#
# Deferred into a function rather than run at load time, so that `help` and
# `--version` still work on a node with no state root configured. Otherwise
# the one command that tells you how to set UVM_ROOT is the one command
# you cannot run without it.
#
# The generated trampolines resolve this same expression in their own /bin/sh
# body (see uvm_trampolines); the two languages share no code, so it is
# written twice on purpose. Both copies must move together — when they
# disagree, a tool is installed under one key and looked for under another:
# every trampoline misses its shim and enters the wrapper on every call, so
# the knob-off path silently pays for a bash start it exists to avoid.

uvm_init() {
  uvm_resolve_root
  arch="${UVM_PLATFORM:-$(uname -m)}"
  uvm_root="${uvm_base}/${arch}"
  uvm_versions="${uvm_root}/versions"
  uvm_current="${uvm_root}/current"
  real_uv="${uvm_current}/uv"
  real_uvx="${uvm_current}/uvx"
  # This root's trampolines, one per shim name: the managed interpreters and
  # any tool without a record. The module keeps it on PATH behind the record
  # trampolines below; see uvm_trampolines.
  uvm_root_bin="${uvm_base}/bin"
  uvm_heal_marker="${uvm_root_bin}/.uv-manager-synced"

  # The durable tree: what the user asked for, kept off scratch so a purge
  # cannot take it with the environments it describes. It is a few KB per
  # tool, so home quota is the right place for it, and it names no
  # architecture, because one record serves every key. Builtin tests only:
  # this runs on every call. With nothing to resolve from, it stays empty and
  # whatever would write there skips; no call fails for it.
  if [[ -n "${UVM_DATA:-}" ]]; then
    uvm_data="${UVM_DATA}" uvm_data_origin="UVM_DATA"
  elif [[ -n "${XDG_DATA_HOME:-}" ]]; then
    uvm_data="${XDG_DATA_HOME}/uvm" uvm_data_origin="\$XDG_DATA_HOME"
  elif [[ -n "${HOME:-}" ]]; then
    uvm_data="${HOME}/.local/share/uvm" uvm_data_origin="\$HOME"
  else
    uvm_data="" uvm_data_origin="nothing: set UVM_DATA"
  fi
  uvm_records="${uvm_data:+${uvm_data}/tools}"
  # The record trampolines, one per executable a record names. Safe for a
  # modulefile to put on PATH because it has no architecture in its path, and
  # durable, so a record keeps its trampoline through a purge; see
  # uvm_trampolines.
  uvm_neutral_bin="${uvm_data:+${uvm_data}/bin}"
}

uvm_data=""
uvm_data_origin=""
uvm_records=""
uvm_neutral_bin=""
uvm_root_bin=""

# ---- knobs -----------------------------------------------------------------

pin="${UVM_PIN:-}"
lock_timeout="${UVM_LOCK_TIMEOUT:-180}"
install_base_url="${UVM_INSTALL_URL:-https://astral.sh/uv}"

# ---- locks -----------------------------------------------------------------
#
# mkdir is atomic on Lustre, GPFS and NFS, needs no helper binary, and does
# not depend on flock — which uv itself requires but which is not enabled on
# every parallel filesystem.
#
# Two locks sit side by side in the per-architecture root: .install.lock for
# provisioning, which writes versions/ and current, and .repair.lock for the
# purge repair, which rewrites tools/ and python/. The parts are disjoint, so
# one lock would serialize work that does not conflict, and it would cost
# correctness too: a repair waiter would fail because of an unrelated slow
# download, and a provisioning waiter past its timeout would exec mid-repair.
# No call holds both, because provisioning has released before a repair
# begins, so the one uvm_lock global below still names everything held.
#
# Only the process whose mkdir created the lock removes it. No call removes or
# takes another call's lock, whatever its age or its owner line records:
# whether a holder on another node is still running is a question a shared
# filesystem cannot answer reliably (attribute caches, clock skew, recycled
# pids), so the wrapper never asks it. A waiter runs out its timeout and then
# does something safe instead. A lock whose holder died stays until a human
# removes it; until then a provisioning call whose request is not yet
# satisfied waits until it is or until the timeout passes.

uvm_lock=""

# Release by path. A process holds a lock exactly while uvm_lock names it,
# and only this process's own mkdir sets uvm_lock, so the directory at that
# path is the one this process made and the only one it removes.
uvm_unlock() {
  [[ -n "${uvm_lock}" ]] || return 0
  local lock="${uvm_lock}"
  # Clear before acting. In the opposite order, a signal landing after the
  # rmdir would make the trap remove the lock the next caller took in the
  # meantime. The cost: bash handles a trapped signal only after the
  # foreground command returns, so a signal during the removal below finds
  # uvm_lock empty and can leave this lock standing for uvm clean lock.
  # Clearing first also makes a second pass one builtin test and no fork,
  # which the EXIT trap after the INT handler's exit 130 needs, and which
  # keeps a release in front of an exec free on the hot path.
  uvm_lock=""
  # owner first, because rmdir refuses a directory holding an entry. That
  # also removes whatever a failed owner write left behind.
  rm -f "${lock}/owner" 2>/dev/null || true
  rmdir "${lock}" 2>/dev/null || true
}

# Release on signals too, not only on a normal return. A RETURN trap alone
# leaves the lock behind when the holder is killed, and until a human removes
# a leaked lock, a provisioning call for that user whose request is not yet
# satisfied waits until it is or until the timeout passes.
trap 'uvm_unlock' EXIT
trap 'uvm_unlock; exit 130' INT
trap 'uvm_unlock; exit 143' TERM

# uvm_acquire_lock LOCK ON_TIMEOUT PREDICATE [ARG...]
#   LOCK        install or repair. Names the lock, ${uvm_root}/.LOCK.lock, and
#               the words its messages use; anything else dies.
#   ON_TIMEOUT  proceed: at UVM_LOCK_TIMEOUT, return 0 holding nothing, so the
#               caller does the work without the lock. For work that is safe
#               to repeat beside another process doing the same.
#               Anything else: die at the timeout naming the holder, for work
#               that two processes must never do at once.
#   PREDICATE   run as "$@" once per second while waiting; true means the
#               caller's work has already been done by someone else.
#
# Returns 0: do the work. The lock is held iff uvm_lock is non-empty, and it
# is empty after a proceed timeout. Returns 1: the predicate came true while
# waiting, and nothing is held. That says the work is done, not that this
# call's result is in place; a caller still does what its own fast path does.
#
# Rules for a predicate. It runs inside an `if`, where errexit is suspended
# for it and for everything it calls, so its status must be the status of the
# test that decides — chain steps with `|| return 1`. It runs once a second
# for up to the whole timeout, so keep it cheap and free of side effects. It
# must never touch uvm_lock.
uvm_acquire_lock() {
  # An explicit count, because both alternatives fail silently. An empty "$@"
  # is a successful no-op, so a call with no predicate would early-out on
  # every contended call and only under contention. ${1:?} exits 0 under the
  # EXIT trap on bash 3.2, the trap's status overriding the error's.
  (( $# >= 3 )) || die "uvm_acquire_lock needs LOCK, ON_TIMEOUT and a predicate"
  local kind="$1" on_timeout="$2"; shift 2
  local what doing
  case "${kind}" in
    install) what="provisioning lock"; doing="provisioning" ;;
    repair)  what="repair lock";       doing="repairing" ;;
    *)       die "uvm_acquire_lock: unknown lock: ${kind}" ;;
  esac
  local lock="${uvm_root}/.${kind}.lock" waited=0 absent=0 notice=30 holder=""
  # Read by a human, by uvm doctor and by nothing else, so it carries what a
  # person needs to find the process. uname -n, not HOSTNAME, which bash
  # leaves at whatever it inherited from a login node or a container image.
  local owner
  owner="host=$(uname -n) pid=$$"

  # The knob is read here and nowhere else, so the guard sits against the
  # code it protects. Inside the function is also what keeps `uvm help` and
  # `uvm --version` answering on a misconfigured node.
  #
  # Form first. On bash 3.2 a non-numeric value makes the arithmetic fatal
  # under `set -u`, and the EXIT trap's own status then overrides the error's,
  # so the script exits 0 and `VER=$(uv --version)` comes back empty and true.
  # It also catches ' ' and -1. Then base 10, onto the global the messages
  # read: bash reads 0600 as 384, and 0800 is not a number at all.
  # Normalizing cannot come first: `$(( 10# ))` on an empty or all-space
  # value is silently 0 on bash 3.2 and an error on 5.2.
  if [[ ! "${lock_timeout}" =~ ^[0-9]+$ ]]; then
    die "UVM_LOCK_TIMEOUT must be a whole number of seconds: UVM_LOCK_TIMEOUT=${lock_timeout}"
  fi
  lock_timeout=$(( 10#${lock_timeout} ))
  # A literal, not a knob. A normal provision finishes far inside it, so it
  # separates a slow holder from a wedged one without filling a many-rank job
  # log on slow egress. Clamped, so every wait that reaches the timeout has
  # spoken once first.
  if (( lock_timeout < notice )); then notice="${lock_timeout}"; fi
  local after="stops waiting and proceeds without the lock"
  [[ "${on_timeout}" == proceed ]] || after="gives up"

  (umask 077; mkdir -p "${uvm_root}") \
    || die "cannot create ${uvm_root} — is ${uvm_base} writable?"

  while ! mkdir "${lock}" 2>/dev/null; do
    # Why mkdir failed cannot be settled by looking again: it can fail EEXIST
    # and the holder release before this test runs, and then a lock that was
    # merely released reads as an unwritable filesystem and the rank dies one
    # iteration from winning. Measured at 2-4% of ranks in 64-way cold
    # bursts, on GPFS and on APFS alike. Persistence decides it instead.
    # Three absences in one wait is a broken mount rather than a race, and
    # that is not a number a site tunes, so it is a literal and not another
    # knob. The count never resets, which holds the iterations it can add
    # to three however the loop alternates.
    if [[ ! -d "${lock}" ]]; then
      absent=$(( absent + 1 ))
      (( absent >= 3 )) || continue
      die "cannot create ${what} at ${lock} — check permissions and quota on ${uvm_base}"
    fi

    # Someone else may have finished the work this call was about to do. The
    # caller names the test, because only the caller knows what "done" means
    # for its work; provisioning passes the version it was asked for.
    if "$@"; then return 1; fi

    # Reset before each read: a failed open never runs read, so the variable
    # would keep its previous value.
    if (( waited == notice || waited >= lock_timeout )); then
      holder=""
      read -r holder 2>/dev/null < "${lock}/owner" || true
    fi
    # Once per wait. The owner line says where the holder ran, not whether it
    # still runs; the message says only that it may. The removal is two steps
    # because owner lives inside the directory: rmdir alone reports
    # Directory not empty. The path is printed whole rather than as a uvm
    # command, because a reader on another node, architecture or UVM_ROOT
    # would otherwise clear a different lock and be told it succeeded.
    if (( waited == notice )); then
      note "waiting for the ${what} at ${lock}
    held by: ${holder:-<none recorded>}
    That process may still be running. At ${lock_timeout}s this call ${after}.
    If nothing is ${doing} this tree, remove the lock with:
        rm -f '${lock}/owner' && rmdir '${lock}'"
    fi
    if (( waited >= lock_timeout )); then
      if [[ "${on_timeout}" == proceed ]]; then return 0; fi
      die "timed out after ${lock_timeout}s waiting for the ${what} at ${lock}
    held by: ${holder:-<none recorded>}"
    fi
    waited=$(( waited + 1 ))
    sleep 1
  done

  # Set before the owner write, not after. A write that fails can leave an
  # entry behind (a quota or a full filesystem after the file was created),
  # and the EXIT trap's release then removes that entry and the directory, so
  # a failed write leaves no lock standing. The redirect keeps its order so
  # the shell's own diagnostic, which carries the errno naming the fault,
  # reaches stderr. This runs as soon as the winning mkdir returns, and the
  # traps release only what it names. Bash handles a trapped signal only
  # after the foreground command returns, so a signal that arrives around
  # the winning mkdir, before this line, can leave an ownerless lock standing
  # for uvm doctor to report and uvm clean lock to remove. That is the
  # accepted cost of a trap that never removes a lock uvm_lock does not name.
  uvm_lock="${lock}"
  printf '%s\n' "${owner}" > "${lock}/owner" \
    || die "cannot record ownership of the ${what} at ${lock}/owner"
}

# ---- fetching --------------------------------------------------------------

uvm_fetch() {
  local url="$1"
  if command -v curl >/dev/null 2>&1; then
    curl -LsSf --retry 3 --retry-connrefused "${url}"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO- --tries=3 "${url}"
  else
    die "neither curl nor wget is available; cannot download uv"
  fi
}

# ---- install ---------------------------------------------------------------

# True when the requested version is on disk; with no version requested, true
# when any uv is selected. The single spelling of "is this request already
# satisfied?", used by the caller and inside uvm_install, which also hands it
# to the lock as the predicate a waiter runs.
uvm_have() {
  local want="$1"
  if [[ -n "${want}" ]]; then
    [[ -x "${uvm_versions}/${want}/uv" ]]
  else
    [[ -x "${real_uv}" ]]
  fi
}

# Point ${uvm_current} at versions/<ver>. The symlink target is relative so
# the tree stays relocatable. With an mv that takes -T or -h the swap is
# atomic, so a concurrent reader never observes a missing or half-written
# `current`; the fallback below is not.
uvm_point_current() {
  local ver="$1" tmp
  [[ "$(readlink -- "${uvm_current}" 2>/dev/null || true)" == "versions/${ver}" ]] && return 0
  tmp="${uvm_root}/.current.$$"
  rm -f "${tmp}" 2>/dev/null || true   # a prior run may have died holding this name
  ln -s "versions/${ver}" "${tmp}"
  # A plain `mv tmp current` follows the existing link and moves tmp inside the
  # version directory it names, so the rename has to be told not to. GNU mv
  # takes -T and BSD mv takes -h; each is a single rename(2), and concurrent
  # swaps then leave `current` at whichever ran last, never missing.
  if ! mv -T "${tmp}" "${uvm_current}" 2>/dev/null &&
     ! mv -h "${tmp}" "${uvm_current}" 2>/dev/null; then
    # An mv with neither option gets a brief non-atomic replace. Between the
    # two steps a concurrent reader finds `current` missing, and a concurrent
    # swap landing there makes this mv follow the new link: tmp nests inside
    # that version directory and this swap never lands. When that version is
    # not ${ver}, `current` never names ${ver} and the caller execs the other
    # version at status 0. A success has selected the requested version only
    # on the paths above.
    rm -f "${uvm_current}" 2>/dev/null || true
    mv "${tmp}" "${uvm_current}"
  fi
}

uvm_installed_version() {
  local ver
  ver="$("$1" --version 2>/dev/null | awk 'NR==1 {print $2}')" || return 1
  [[ -n "${ver}" ]] || return 1
  printf '%s\n' "${ver}"
}

# uvm_install WANT FORCE
#   WANT   version to install and select; empty means "latest"
#   FORCE  non-empty to go to the network even if WANT is already on disk
#
# Both are parameters rather than globals: the predicate the lock runs while
# waiting has to test the version this particular call is serving.
#
# Every path that returns ends in the one selection step at the bottom: the
# fast path, the lock's early-out, the re-check under the lock and a fresh
# install. Nothing returns early, so a return means the requested version has
# been selected (with an mv that takes -T or -h; see uvm_point_current), and
# selection is spelled once. With WANT set, that version or nothing: an
# installer that delivered another one leaves it on disk
# unselected and the call dies naming WANT, because running another version
# at status 0 is what a pin exists to prevent. With no WANT, any selected uv
# satisfies the call, and only a fresh install has something to select.
uvm_install() {
  local want="$1" force="${2:-}"
  local url tmp ver="" dest err
  # "Is this call's work already done?", asked by the fast path, by the lock
  # while waiting and again under the lock. Never empty: an empty predicate is
  # a successful no-op that would read as satisfied, and an empty array is
  # fatal under `set -u` on bash 3.2. A forced install is never satisfied.
  local satisfied=(uvm_have "${want}")
  [[ -z "${force}" ]] || satisfied=(false)

  # Install only when the work is not already done, then not done by whoever
  # held the lock (the lock returns 1 when its predicate came true while
  # waiting), and still not done once this call holds the lock, or has
  # waited out the timeout and proceeds without it: the holder may have
  # published between the last poll and now. Every other outcome falls
  # through to selection. Past the timeout nothing is held, and every
  # uvm_unlock below is then a no-op.
  if ! "${satisfied[@]}" &&
     uvm_acquire_lock install proceed "${satisfied[@]}" &&
     ! "${satisfied[@]}"; then
    url="${install_base_url}/install.sh"
    [[ -n "${want}" ]] && url="${install_base_url}/${want}/install.sh"

    mkdir -p "${uvm_versions}"
    tmp="$(mktemp -d "${uvm_versions}/.incoming.XXXXXXXX")"

    note "installing uv (${want:-latest}) for ${arch}"

    # UV_INSTALL_DIR and CARGO_DIST_FORCE_INSTALL_DIR are checked by
    # install.sh BEFORE UV_UNMANAGED_INSTALL and take precedence over it. If a
    # user has either exported, uv lands somewhere else entirely, the binary
    # we expect never appears, and every subsequent invocation re-runs the
    # installer and fails. Scrub them. Mirror-related variables are left
    # alone: they only redirect where the tarball comes from, which is
    # legitimate site policy.
    #
    # The installer's progress output goes to stderr, not stdout.
    # Provisioning is a side effect of whatever the user actually asked for,
    # and on a cold node `VER=$(uv --version)` must not come back with four
    # lines of installer chatter ahead of the answer.
    if ! uvm_fetch "${url}" \
          | env -u UV_INSTALL_DIR -u CARGO_DIST_FORCE_INSTALL_DIR \
                UV_UNMANAGED_INSTALL="${tmp}" sh >&2; then
      rm -rf "${tmp}" 2>/dev/null || true
      uvm_unlock
      die "install failed — no egress from this node?
    Pre-warm from a node of this architecture (${arch}) that has outbound
    HTTPS, then retry here. Any uv command will do:  uv --version"
    fi

    if ! ver="$(uvm_installed_version "${tmp}/uv")"; then
      rm -rf "${tmp}" 2>/dev/null || true
      uvm_unlock
      die "installed uv is not runnable on this node (${arch}) — wrong architecture?"
    fi

    # Publish by rename within versions/, so a reader never sees a partial
    # tree. A call that proceeded past the lock timeout publishes beside
    # whoever else did, and both copies are the same version, so either may
    # win; the loser discards its own uniquely named staging directory and
    # nothing else. No directory rename at the portability floor refuses an
    # existing target -- mv onto a directory moves the source inside it and
    # exits 0 -- so the race is detected afterwards rather than prevented. A
    # rival that lands before mv looks leaves ours nested in its tree; one
    # that lands between mv's look and the rename makes mv fail with the
    # version already published.
    dest="${uvm_versions}/${ver}"
    if [[ -d "${dest}" ]]; then
      rm -rf "${tmp}" 2>/dev/null || true   # already had this version
    elif ! err="$(mv "${tmp}" "${dest}" 2>&1)"; then
      rm -rf "${tmp}" 2>/dev/null || true
      if [[ ! -x "${dest}/uv" ]]; then      # no rival published it either
        uvm_unlock
        die "cannot publish uv ${ver} into ${dest}: ${err}"
      fi
    elif [[ -e "${dest}/${tmp##*/}" ]]; then
      rm -rf "${dest:?}/${tmp##*/}" 2>/dev/null || true   # a rival won; mv nested ours inside it
    fi
  fi

  # The one selection step. It runs before the release: an unpinned waiter's
  # predicate asks only whether current/uv exists, so a holder that released
  # before selecting would let the next waiter install again. The die is the
  # last line on stderr and names the version asked for; the EXIT trap
  # releases a lock still held.
  if [[ -n "${want}" ]]; then
    uvm_have "${want}" \
      || die "uv ${want} is not installed after provisioning${ver:+ (the installer delivered ${ver})}"
    uvm_point_current "${want}"
  elif [[ -n "${ver}" ]]; then
    uvm_point_current "${ver}"
  fi
  uvm_unlock
}

# A pin is honoured even when some other version is already installed: it
# selects which version `current` points at, not merely which version to
# download if nothing is present. uvm_install does that selection, on its
# fast path as on every other. `current` is one link per root, so concurrent
# calls pinned to different versions race for it and the last swap wins;
# calls sharing one pin agree on it whichever swap lands last.
uvm_ensure_uv() {
  uvm_install "${pin}" ""
  [[ -x "${real_uv}" ]] || die "uv is still missing after provisioning: ${real_uv}"
}

# ---- storage layout --------------------------------------------------------

# The storage layout, defined once. Everything else reads these variables
# rather than rebuilding the same paths, so adding a directory is a one-line
# change here. Pure: sets variables, touches no filesystem, so the read-only
# subcommands can call it without provisioning anything.
uvm_set_paths() {
  export UV_CACHE_DIR="${uvm_root}/cache"
  export UV_TOOL_DIR="${uvm_root}/tools"
  export UV_TOOL_BIN_DIR="${uvm_root}/bin/shims"
  export UV_PYTHON_INSTALL_DIR="${uvm_root}/python"
  export UV_PYTHON_BIN_DIR="${uvm_root}/bin/python-shims"

  # XDG_CONFIG_HOME is left alone on purpose: that's where a user's own
  # ~/.config/uv/uv.toml (index URLs, auth, mirrors) lives, and hiding it
  # would change resolution behaviour, not just storage location. It is also
  # where the standalone installer looks for its receipt.
}

uvm_export_env() {
  uvm_set_paths

  # Guarded, not unconditional. Resolving six directories that already exist
  # costs a fork, an exec, and — under GNU coreutils — one EEXIST-failing
  # mkdir(2) per path component of every operand, so the syscall count grows
  # with the depth of UVM_ROOT and a scratch path is deep. Measured at 2 ms of
  # a 12 ms invocation, on the path `uv run` takes inside loops that call it
  # thousands of times, issued by every rank of a job at once against a single
  # metadata server. Five builtin tests cost microseconds and spawn nothing.
  #
  # The test stays outside the subshell. Moved inside, the fork survives and a
  # third of the saving goes with it.
  #
  # A missing directory is still created, under umask 077. That is the half of
  # the old unconditional call that was load-bearing — it restores the shape of
  # a tree a scratch purge has partially removed. It does not repair modes:
  # mkdir -p never chmods a directory that already exists, so the property is
  # "directories we create are 0700", not "our directories are 0700".
  #
  # Neither trampoline directory is among them. Only a trampoline sync creates
  # those, so no plain uv or uvx call writes under UVM_DATA.
  if [[ ! -d "${UV_CACHE_DIR}" || ! -d "${UV_TOOL_DIR}" || ! -d "${UV_TOOL_BIN_DIR}" \
     || ! -d "${UV_PYTHON_INSTALL_DIR}" || ! -d "${UV_PYTHON_BIN_DIR}" ]]; then
    (
      umask 077
      mkdir -p "${UV_CACHE_DIR}" "${UV_TOOL_DIR}" "${UV_TOOL_BIN_DIR}" \
               "${UV_PYTHON_INSTALL_DIR}" "${UV_PYTHON_BIN_DIR}"
    )
  fi
  uvm_export_trees
}

# The exports alone, after uvm_set_paths. Creates nothing, so the knob-off
# trampoline entry runs this and not the guard above: a call that only execs a
# shim leaves the tree exactly as it found it.
uvm_export_trees() {
  # The two trees, for everything the wrapper runs. A trampoline finds the
  # shims through UVM_ROOT, and a child that re-enters the wrapper then
  # resolves the trees this call did, even when the root came from the
  # cascade rather than the environment. Both name no architecture, so they
  # are as safe to inherit across node types as the modulefile's own.
  export UVM_ROOT="${uvm_base}"
  if [[ -n "${uvm_data}" ]]; then export UVM_DATA="${uvm_data}"; fi

  # Both the arch-specific shim dirs (correct for this node, for anything we
  # exec) and the record trampolines (correct everywhere, and what the
  # modulefile puts first on PATH). The root's own trampolines are not added:
  # the shim directories ahead of them reach the same executables.
  #
  # Prepended idempotently: the exported PATH is inherited by everything uv
  # spawns, and anything that re-enters the wrapper would otherwise add the
  # same three entries again at every level of nesting.
  if [[ -n "${uvm_neutral_bin}" ]]; then uvm_path_prepend "${uvm_neutral_bin}"; fi
  uvm_path_prepend "${UV_PYTHON_BIN_DIR}"
  uvm_path_prepend "${UV_TOOL_BIN_DIR}"
  export PATH
}

uvm_path_prepend() {
  case ":${PATH}:" in
    *":$1:"*) return 0 ;;
  esac
  PATH="$1:${PATH}"
}

# ---- architecture-neutral trampolines --------------------------------------
#
# `uv tool install ruff` drops an executable in a per-architecture directory.
# That directory cannot go on PATH from a modulefile, because a modulefile is
# evaluated on the login node and inherited by compute nodes of a different
# architecture. So instead we maintain neutral directories of tiny shell
# trampolines that re-resolve the platform key at exec time.
#
# There are two, and a sync keeps each to its own rule:
#
#   $UVM_DATA/bin   one per executable a record names, off scratch, so a purge
#                   that takes the shim leaves the trampoline that can restore
#                   it. One is removed only when no record names it, which in
#                   practice is a `uv tool uninstall`. Records are shared by
#                   every root that shares UVM_DATA, so every root's sync
#                   writes the same set here.
#   $UVM_ROOT/bin   one per shim name in this root, under any architecture,
#                   dangling or not: the managed interpreters and any tool
#                   without a record, which no record can name. One is removed
#                   when no shim in this root names it, as 0.7.0 did. A sync
#                   never touches another root's.
#
# The module puts the first ahead of the second on PATH. A tool on an
# architecture where it is not installed reports that, instead of failing
# with "Exec format error".
#
# 0.7.0 wrote its trampolines to $UVM_ROOT/bin with a body that never enters
# the wrapper. A sync rewrites each marked one a shim names in place, under
# the same path, and never removes it for being old: a job script's shell
# that has already run the tool has hashed that path, and its next call must
# still find a file there.
#
# The body has three paths. With UVM_REPAIR off, UVM_ROOT set and the shim
# executable, it execs the shim and nothing else: no bash, no lock, the cost
# of one `sh` start, cheaper than 0.7.0's body, which located the tree from
# $0 with two command substitutions and a dirname. With the knob on, or the
# shim missing, or UVM_ROOT unset, it execs `uv-manager _trampoline NAME`,
# which runs the scope check a uv call runs, resolves the root by the same
# cascade, and runs the shim or says why it cannot. The root is never baked
# in: two clusters sharing UVM_DATA have a root each. The knob reads as the
# wrapper reads it: unset, empty and 0 are off, everything else on.
#
# The wrapper it enters is the uv-manager on PATH, which is what the user's
# uv resolves, so the check a trampoline runs and the check a uv call runs
# are one version's. The generating wrapper's own directory is baked in
# behind it for a context that runs the wrapper by absolute path with no
# module; a path containing a single quote is not baked, and a trampoline
# that finds neither says so.
#
# The body resolves the platform key the way uvm_init does, on the executing
# node and from the invoker's environment. See the platform-key banner: the
# expression is duplicated across two languages and both copies must move
# together.

readonly uvm_tramp_marker="# uv-manager-trampoline"

# The self-heal's marker, in this root's trampoline directory. A sync of that
# directory writes it, and the dispatch tail syncs both directories when it is
# missing; see the self-heal there. A dot name, so it is never on PATH as a
# command and no removal loop sees it.
uvm_heal_marker=""

# The directories the last sync wrote, for `uvm trampolines` to report.
uvm_synced=()

# [records]: syncs both directories, or with `records` the record trampolines
# alone, which is all doctor may write: the other directory is under UVM_ROOT.
# A sync of this root's directory ends by writing the self-heal's marker, and
# one that did not write that directory removes it, so the next call retries.
# Doctor, which passes `records`, can neither set it nor clear it.
uvm_trampolines() {
  local names="" f d self hit=""
  uvm_synced=()
  self="$(abspath "$0")"; self="${self%/*}/uv-manager"
  case "${self}" in *"'"*) self="" ;; esac

  # Every branch ends in a zero status, so the substitution cannot trip
  # errexit under pipefail.
  if [[ -n "${uvm_records}" ]]; then
    names="$(
      for f in "${uvm_records}"/*/entrypoints; do
        if [[ -f "${f}" ]]; then cat -- "${f}"; fi
      done | sort -u
    )"
  fi
  uvm_trampoline_dir "${uvm_neutral_bin}" "${names}" "${self}"
  [[ "${1:-}" != records && -d "${uvm_base}" ]] || return 0

  names="$(
    for d in "${uvm_base}"/*/bin/shims "${uvm_base}"/*/bin/python-shims; do
      [[ -d "${d}" ]] || continue
      for f in "${d}"/*; do
        [[ -e "${f}" || -L "${f}" ]] || continue
        printf '%s\n' "${f##*/}"
      done
    done | sort -u
  )"
  uvm_trampoline_dir "${uvm_root_bin}" "${names}" "${self}"
  for d in ${uvm_synced[@]+"${uvm_synced[@]}"}; do
    if [[ "${d}" == "${uvm_root_bin}" ]]; then hit=1; fi
  done
  if [[ -n "${hit}" ]]; then
    : 2>/dev/null > "${uvm_heal_marker}" || true
  elif [[ -e "${uvm_heal_marker}" ]]; then
    rm -f "${uvm_heal_marker}" 2>/dev/null || true
  fi
  return 0
}

# Says which directories the last sync wrote, and why any other was left as
# it was, for `uvm trampolines`.
uvm_trampolines_report() {
  local d s hit wrote="" left=""
  for d in ${uvm_neutral_bin:+"${uvm_neutral_bin}"} "${uvm_root_bin}"; do
    hit=0
    for s in ${uvm_synced[@]+"${uvm_synced[@]}"}; do
      if [[ "${s}" == "${d}" ]]; then hit=1; fi
    done
    if (( hit )); then wrote+="${wrote:+ and }${d}"; else left+="${left:+ and }${d}"; fi
  done
  if [[ -n "${wrote}" ]]; then note "trampolines synced in ${wrote}"; fi
  if [[ -n "${left}" ]]; then note "left ${left} as it was: it cannot be created or written"; fi
  if [[ -z "${uvm_neutral_bin}" ]]; then
    note "no trampolines for the records: UVM_DATA, XDG_DATA_HOME and HOME are all unset"
  fi
  return 0
}

# DIR NAMES WRAPPER: writes a trampoline in DIR for each line of NAMES, then
# removes each marked file in DIR that NAMES does not list, and adds DIR to
# uvm_synced. A DIR that cannot be created or written is left exactly as it
# is, nothing written and nothing removed: mkdir -p succeeds on a directory
# that exists read-only, so the guard tests -w as well. Returns 0.
#
# A write can still fail inside a writable DIR, on a block quota or a full
# filesystem, after creating the temporary file. Renamed into place, that
# empty file would replace a working trampoline with one that exits 0 and
# runs nothing. So a failed write, chmod or rename removes the temporary file
# and stops the sync there: the trampoline it was replacing stays, nothing is
# removed, and DIR is not added to uvm_synced.
#
# The temporary name carries the host as well as the pid: writers on two
# nodes of a shared filesystem can share a pid, and the self-heal and the
# repair's holder sync from ranks on every node of a job. HOSTNAME can be
# inherited from a login node (see uvm_acquire_lock), so $RANDOM goes in
# too. All three cost no fork.
uvm_trampoline_dir() {
  local dir="$1" names="$2" self="$3" name dest tmp f tag="${HOSTNAME:-}.$$.${RANDOM}"
  [[ -n "${dir}" ]] || return 0
  (umask 077; mkdir -p "${dir}") 2>/dev/null || return 0
  [[ -d "${dir}" && -w "${dir}" ]] || return 0

  # Rewrite every trampoline we own rather than skipping any name that already
  # exists: one truncated by a purge, or written by an older uv-manager, has to
  # be repaired, and skipping on mere existence means it never is. The new
  # file is renamed over the old, so a path a shell has hashed keeps naming a
  # trampoline. A file that is non-empty, executable and unmarked is somebody's
  # own script that happens to share the name; leave it, and say so.
  while IFS= read -r name; do
    [[ -n "${name}" && "${name}" != */* && "${name}" != .* ]] || continue
    dest="${dir}/${name}"
    if [[ -e "${dest}" || -L "${dest}" ]] \
       && ! grep -q "${uvm_tramp_marker}" "${dest}" 2>/dev/null \
       && [[ -s "${dest}" && -x "${dest}" ]]; then
      note "not overwriting ${dest} (not generated by uv-manager)"
      continue
    fi
    tmp="${dir}/.${name}.${tag}"
    if cat > "${tmp}" <<TRAMPOLINE && chmod 0755 "${tmp}" && mv -f "${tmp}" "${dest}"
#!/bin/sh
${uvm_tramp_marker} — generated; edits will be lost.
n=\${0##*/}
case \${UVM_REPAIR:-0} in
0)  if [ -n "\${UVM_ROOT:-}" ]; then
        a=\${UVM_PLATFORM:-\$(uname -m)}
        for s in shims python-shims; do
            if [ -x "\$UVM_ROOT/\$a/bin/\$s/\$n" ]; then exec "\$UVM_ROOT/\$a/bin/\$s/\$n" "\$@"; fi
        done
    fi ;;
esac
w=\$(command -v uv-manager) || w='${self}'
if [ ! -x "\$w" ]; then
    echo "uv-manager: '\$n' needs uv-manager on PATH; load the uv module." >&2
    exit 127
fi
exec "\$w" _trampoline "\$n" "\$@"
TRAMPOLINE
    then
      continue
    fi
    rm -f "${tmp}" 2>/dev/null || true
    return 0
  done <<< "${names}"

  # Only ever remove files we generated.
  for f in "${dir}"/*; do
    [[ -f "${f}" ]] || continue
    grep -q "${uvm_tramp_marker}" "${f}" 2>/dev/null || continue
    printf '%s\n' "${names}" | grep -qxF -- "${f##*/}" || rm -f "${f}"
  done
  uvm_synced+=("${dir}")
  return 0
}

# NAME: exits 127 for a command whose shim is not here, saying why. Builtins
# up to the message: it runs with the knob off, and takes no lock and writes
# nothing.
uvm_tool_missing() {
  local f ep
  for f in ${uvm_records:+"${uvm_records}"/*/entrypoints}; do
    [[ -f "${f}" ]] || continue
    while IFS= read -r ep || [[ -n "${ep}" ]]; do
      [[ "${ep}" == "$1" ]] || continue
      cat >&2 <<EOF
uv-manager: '$1' is recorded but not installed for architecture '${arch}'.
uv-manager: With UVM_REPAIR set, running it restores it here; uv-manager doctor says more.
EOF
      exit 127
    done < "${f}"
  done
  cat >&2 <<EOF
uv-manager: '$1' is not installed for architecture '${arch}'.
uv-manager: it exists for another architecture; install it here with
uv-manager:     uv tool install <package>
EOF
  exit 127
}

# NAME [ARG...]: what a trampoline runs when it cannot exec the shim itself,
# reached as `uv-manager _trampoline NAME`. With the knob on it runs the same
# scope check, lock, outcome and failure contract a uv call runs, then, when
# the shim is still missing, restores the recorded tool that provides it,
# then the shim. With it off it runs the shim, or says why it cannot without
# provisioning, locking or creating anything. The shim is an exec site, so it
# releases first, and its exit status and signals are the tool's own.
uvm_tool_entry() {
  local name="${1:-}" d
  [[ -n "${name}" && "${name}" != */* ]] || die "_trampoline needs a command name"
  shift
  uvm_init
  uvm_set_paths
  if [[ -n "${UVM_REPAIR:-}" && "${UVM_REPAIR}" != 0 ]]; then
    uvm_ensure_uv
    uvm_export_env
    uvm_repair
    if [[ ! -x "${UV_TOOL_BIN_DIR}/${name}" && ! -x "${UV_PYTHON_BIN_DIR}/${name}" ]]; then
      uvm_restore_by_name "${name}"
    fi
  fi
  for d in "${UV_TOOL_BIN_DIR}" "${UV_PYTHON_BIN_DIR}"; do
    [[ -x "${d}/${name}" ]] || continue
    uvm_export_trees
    uvm_unlock
    exec "${d}/${name}" "$@"
  done
  uvm_tool_missing "${name}"
}

# ---- tool records ----------------------------------------------------------
#
# A purge takes a tool environment and leaves nothing that says what the user
# asked for: the receipt goes with the rest of the tree. So every `uv tool
# install`, `upgrade` and `uninstall` that exits 0 through the wrapper keeps a
# record of each tool it changed, under $UVM_DATA/tools/<name>/, off scratch:
#
#   request          the arguments after `uv tool install`, one per line
#   constraints      name==version, or name @ <source>, one per distribution;
#                    a file uv reads with -c as it stands
#   python           the interpreter's major.minor
#   entrypoints      the executables uv linked into UV_TOOL_BIN_DIR
#   uv-receipt.toml  uv's receipt, byte for byte, copied and never parsed
#
# Plain files, one item per line, so nothing here parses TOML or JSON beyond
# four fields of direct_url.json, which uv writes on one line. A record names
# no architecture: the dist-info names and the request are the same on every
# key, and one record serves them all.
#
# No credential reaches the record. A URL's userinfo is stripped from every
# argument and from every source URL; uv already strips it from its receipt,
# and the copy is skipped should one ever carry it under any scheme. A
# password-less ssh login is kept: it is not a secret, and the source cannot
# be fetched without it.
#
# A record is staged whole under a name of this process's own, carrying its
# host, pid and a $RANDOM as a trampoline's temporary name does, the old one
# moved aside and the stage renamed in, so a reader sees the old record, none,
# or the new one, never half of one. No primitive renames a directory over a
# non-empty one, and mv onto an existing directory moves the source inside it.
# A rival's record landing between the two renames therefore swallows this
# stage, which is removed as the installer's publisher removes its own.
#
# None of it may change the status of the command that ran. Every writer here
# returns 0; a record that cannot be written leaves a note on stderr.

uvm_stripped=""

# STRING: sets uvm_stripped to STRING with the userinfo of every URL in it
# removed. Builtins only.
uvm_strip_userinfo() {
  local s="$1" pre user post re='^(.*://)([^/@]*)@(.*)$'
  while [[ "${s}" =~ ${re} ]]; do
    pre="${BASH_REMATCH[1]}" user="${BASH_REMATCH[2]}" post="${BASH_REMATCH[3]}"
    if [[ "${pre}" == *ssh:// && "${user}" != *:* ]]; then break; fi
    s="${pre}${post}"
  done
  uvm_stripped="${s}"
}

# FILE: true when a URL in FILE, under any scheme, carries userinfo that
# uvm_strip_userinfo would remove, which is all of it but a password-less ssh
# login. The receipt is copied whole or not at all, so this decides the copy.
uvm_carries_userinfo() {
  local line user re='([A-Za-z][A-Za-z0-9+.-]*)://([^/@"[:space:]]*)@(.*)$'
  while IFS= read -r line || [[ -n "${line}" ]]; do
    while [[ "${line}" =~ ${re} ]]; do
      user="${BASH_REMATCH[2]}"
      if [[ "${BASH_REMATCH[1]}" != *ssh || "${user}" == *:* ]]; then return 0; fi
      line="${BASH_REMATCH[3]}"
    done
  done < "$1"
  return 1
}

# TOOLDIR: prints one constraint per distribution in the environment. A
# distribution with no direct_url.json came from an index and is pinned by
# version; one with it is pinned to its source, a VCS one to its commit, and
# either within the subdirectory it was built from, which uv matches against
# the request as part of the URL. Returns 1 when a direct_url.json names no
# URL, rather than pin such a distribution to an index it never came from.
uvm_record_constraints() {
  local di dist json line url vcs commit sub
  local re_url='"url":"([^"]*)"' re_vcs='"vcs":"([a-z]+)"' re_commit='"commit_id":"([0-9a-f]+)"'
  local re_sub='"subdirectory":"([^"]*)"'
  for di in "$1"/lib/*/site-packages/*.dist-info; do
    [[ -d "${di}" ]] || continue
    dist="${di##*/}"; dist="${dist%.dist-info}"
    if [[ ! -f "${di}/direct_url.json" ]]; then
      printf '%s==%s\n' "${dist%-*}" "${dist##*-}"
      continue
    fi
    json=""
    while IFS= read -r line || [[ -n "${line}" ]]; do json+="${line}"; done < "${di}/direct_url.json"
    [[ "${json}" =~ ${re_url} ]] || return 1
    uvm_strip_userinfo "${BASH_REMATCH[1]}"; url="${uvm_stripped}"
    vcs="" commit="" sub=""
    if [[ "${json}" =~ ${re_vcs} ]]; then vcs="${BASH_REMATCH[1]}"; fi
    if [[ "${json}" =~ ${re_commit} ]]; then commit="${BASH_REMATCH[1]}"; fi
    if [[ "${json}" =~ ${re_sub} ]]; then sub="#subdirectory=${BASH_REMATCH[1]}"; fi
    if [[ -n "${vcs}" ]]; then
      printf '%s @ %s+%s%s%s\n' "${dist%-*}" "${vcs}" "${url}" "${commit:+@${commit}}" "${sub}"
    else
      printf '%s @ %s%s\n' "${dist%-*}" "${url}" "${sub}"
    fi
  done
}

# TOOL [ARG...]: writes the record of TOOL from its environment under
# UV_TOOL_DIR. ARGs are its request; with none, the existing record's request
# is kept. A tool with neither has nothing to say what was asked for and is
# skipped here. Returns 0 on every path.
uvm_record_write() {
  local tool="$1" dir rec stage old
  shift
  [[ -n "${uvm_records}" ]] || return 0
  dir="${UV_TOOL_DIR}/${tool}" rec="${uvm_records}/${tool}"
  stage="${uvm_records}/.${tool}.${HOSTNAME:-}.$$.${RANDOM}" old="${stage}.old"
  if (( $# == 0 )) && [[ ! -f "${rec}/request" ]]; then return 0; fi
  if ! (
    umask 077
    local a f line py="" re_py='^version(_info)?[[:space:]]*=[[:space:]]*([0-9]+\.[0-9]+)'
    [[ -f "${dir}/uv-receipt.toml" && -f "${dir}/pyvenv.cfg" ]] || exit 1
    mkdir -p "${uvm_records}" || exit 1
    rm -rf "${stage}" && mkdir "${stage}" || exit 1
    if (( $# )); then
      for a in "$@"; do uvm_strip_userinfo "${a}"; printf '%s\n' "${uvm_stripped}"; done \
        > "${stage}/request" || exit 1
    else
      cp "${rec}/request" "${stage}/request" || exit 1
    fi
    uvm_record_constraints "${dir}" > "${stage}/constraints" || exit 1
    while IFS= read -r line || [[ -n "${line}" ]]; do
      if [[ "${line}" =~ ${re_py} ]]; then py="${BASH_REMATCH[2]}"; break; fi
    done < "${dir}/pyvenv.cfg"
    [[ -n "${py}" ]] || exit 1
    printf '%s\n' "${py}" > "${stage}/python" || exit 1
    # uv links each entrypoint into UV_TOOL_BIN_DIR; python and the activate
    # scripts have no link there, so -ef tells them apart without a fork.
    for f in "${dir}"/bin/*; do
      if [[ "${UV_TOOL_BIN_DIR}/${f##*/}" -ef "${f}" ]]; then printf '%s\n' "${f##*/}"; fi
    done > "${stage}/entrypoints" || exit 1
    if ! uvm_carries_userinfo "${dir}/uv-receipt.toml"; then
      cp "${dir}/uv-receipt.toml" "${stage}/uv-receipt.toml" || exit 1
    fi
    if [[ -e "${rec}" ]]; then mv "${rec}" "${old}" || exit 1; fi
    mv "${stage}" "${rec}" || exit 1
    rm -rf "${rec:?}/${stage##*/}" "${old}"
  ); then
    rm -rf "${stage}" 2>/dev/null || true
    note "could not write the record of tool '${tool}' under ${uvm_records}"
  fi
  return 0
}

# Prints one line per tool under UV_TOOL_DIR: its name, its receipt's cksum
# and inode, and its dist-info names. A uv tool command changed exactly the
# tools whose line it changed. The inode is the part that catches a forced
# reinstall of the same versions, which writes a new receipt with the same
# bytes. One cksum and one ls for every receipt; this runs only around the
# commands that change what is installed.
uvm_tool_marks() {
  local d tool c s p i di sum ino dists sums="" inodes="" receipts=()
  for d in "${UV_TOOL_DIR}"/*/; do
    if [[ -f "${d}uv-receipt.toml" ]]; then receipts+=("${d}uv-receipt.toml"); fi
  done
  if (( ${#receipts[@]} )); then
    sums="$(cksum "${receipts[@]}" 2>/dev/null)" || true
    inodes="$(ls -i "${receipts[@]}" 2>/dev/null)" || true
  fi
  for d in "${UV_TOOL_DIR}"/*/; do
    [[ -d "${d}" ]] || continue
    tool="${d%/}"; tool="${tool##*/}"
    sum="-" ino="-" dists=""
    while read -r c s p; do
      if [[ "${p}" == "${d}uv-receipt.toml" ]]; then sum="${c}:${s}"; fi
    done <<< "${sums}"
    while read -r i p; do
      if [[ "${p}" == "${d}uv-receipt.toml" ]]; then ino="${i}"; fi
    done <<< "${inodes}"
    for di in "${d}"lib/*/site-packages/*.dist-info; do
      if [[ -d "${di}" ]]; then dists+=" ${di##*/}"; fi
    done
    printf '%s %s %s%s\n' "${tool}" "${sum}" "${ino}" "${dists}"
  done
}

# SUBCMD BEFORE [ARG...]: after a `uv tool SUBCMD` that exited 0, brings the
# records in line with what it changed, BEFORE being uvm_tool_marks from just
# ahead of it. An install that changed one tool records the arguments as
# typed; one that changed several (a --with of another tool's name, say)
# cannot tell whose arguments they were, so each keeps the request it had.
# An upgrade keeps every request and moves the pins. An uninstall deletes the
# record of each tool that is gone.
uvm_records_update() {
  local sub="$1" before="$2" after line tool old nl=$'\n' changed=()
  shift 2
  [[ -n "${uvm_records}" ]] || return 0
  after="$(uvm_tool_marks)" || return 0
  case "${sub}" in
    uninstall)
      while IFS= read -r line; do
        tool="${line%% *}"
        [[ -n "${tool}" && -d "${uvm_records}/${tool}" ]] || continue
        case "${nl}${after}" in *"${nl}${tool} "*) continue ;; esac
        old="${uvm_records}/.${tool}.${HOSTNAME:-}.$$.${RANDOM}.old"
        { mv "${uvm_records}/${tool}" "${old}" && rm -rf "${old}"; } \
          || note "could not delete the record of tool '${tool}' under ${uvm_records}"
      done <<< "${before}"
      ;;
    install|upgrade)
      while IFS= read -r line; do
        [[ -n "${line}" ]] || continue
        case "${nl}${before}${nl}" in *"${nl}${line}${nl}"*) continue ;; esac
        changed+=("${line%% *}")
      done <<< "${after}"
      if [[ "${sub}" == install ]] && (( ${#changed[@]} == 1 )); then
        uvm_record_write "${changed[0]}" ${1+"$@"}
      else
        for tool in ${changed[@]+"${changed[@]}"}; do uvm_record_write "${tool}"; done
      fi
      ;;
  esac
  return 0
}

# NAME: true when NAME has a record.
uvm_recorded() {
  [[ -n "${uvm_records}" && -f "${uvm_records}/$1/request" ]]
}

# TOOL: sets uvm_unpinned to the source a backfill cannot pin TOOL to, or to
# nothing. A requirement uv installed from a git, URL or local source is
# pinned by its distribution's direct_url.json. A purge can take that file and
# leave the receipt, and a record written then would pin the distribution by
# version alone: its restore would fetch a branch head, or an index's release,
# in its place. Such a tool gets no record, keeps the in-place arm's refusal,
# and doctor names it.
#
# The test is per requirement: each one the receipt names with a source, the
# tool and each such --with package, must have a direct_url.json in its own
# dist-info directory. A count would not do, since a dependency installed from
# a direct URL keeps a direct_url.json of its own and would stand in for the
# tool's. Names compare as wheel names do, case aside and with - and . as _.
# An entry that names no distribution cannot be matched, and refuses.
uvm_unpinnable() {
  local i want di dist found nocase=0
  uvm_unpinned=""
  uvm_tool_receipt "$1"
  (( uvm_receipt_sources > 0 )) || return 0
  if shopt -q nocasematch; then nocase=1; fi
  shopt -s nocasematch
  for (( i = 0; i < uvm_receipt_sources; i++ )); do
    want="${uvm_receipt_reqs[i]//[-.]/_}" found=0
    for di in ${want:+"${UV_TOOL_DIR}/$1"/lib/*/site-packages/*.dist-info}; do
      [[ -f "${di}/direct_url.json" ]] || continue
      dist="${di##*/}"; dist="${dist%.dist-info}"; dist="${dist%-*}"
      if [[ "${dist//[-.]/_}" == "${want}" ]]; then found=1; break; fi
    done
    if (( ! found )); then uvm_unpinned="${uvm_receipt_reqs_from[i]}"; break; fi
  done
  if (( ! nocase )); then shopt -u nocasematch; fi
  return 0
}

# TOOL: sets uvm_index_args to the index options TOOL's receipt records under
# [tool.options], in the forms uv 0.13.6 writes on one line: index-url as a
# quoted string, extra-index-url as an array of them, index as an array of
# inline tables, one --index URL each or --default-index URL for the one with
# default = true, and index-strategy as a quoted string. An index entry is
# carried when it holds a url and nothing but a name, default, and uv's own
# defaults for explicit, format and authenticate; any other key or value
# there, or an array not read to its end, carries none of that array, since
# half of one would drop an index silently. Anything else is not read, and a
# backfilled record replays under the configuration in effect at the restore
# instead. The record's writer strips userinfo from every URL.
uvm_receipt_indexes() {
  local f="${UV_TOOL_DIR}/$1/uv-receipt.toml" line table="" rest entry url dflt ok extra=()
  local header='^\[([^]]*)\]$' re_index='^index-url = "([^"\\]*)"$'
  local re_extra='^extra-index-url = \[(.*)\]$' re_item='^[[:space:]]*"([^"\\]*)"[[:space:]]*,?(.*)$'
  local re_tables='^index = \[(.*)\]$' re_table='^[[:space:]]*\{([^{}]*)\}[[:space:]]*,?(.*)$'
  local re_pair='^[[:space:]]*([a-z-]+)[[:space:]]*=[[:space:]]*("[^"\\]*"|true|false)[[:space:]]*,?(.*)$'
  local re_strategy='^index-strategy = "([a-z-]+)"$'
  uvm_index_args=()
  [[ -f "${f}" ]] || return 0
  while IFS= read -r line || [[ -n "${line}" ]]; do
    if [[ "${line}" =~ ${header} ]]; then table="${BASH_REMATCH[1]}"; continue; fi
    [[ "${table}" == tool.options ]] || continue
    if [[ "${line}" =~ ${re_index} ]]; then
      uvm_index_args+=(--index-url "${BASH_REMATCH[1]}")
    elif [[ "${line}" =~ ${re_strategy} ]]; then
      uvm_index_args+=(--index-strategy "${BASH_REMATCH[1]}")
    elif [[ "${line}" =~ ${re_extra} ]]; then
      rest="${BASH_REMATCH[1]}" extra=()
      while [[ "${rest}" =~ ${re_item} ]]; do
        extra+=(--extra-index-url "${BASH_REMATCH[1]}"); rest="${BASH_REMATCH[2]}"
      done
      if [[ -z "${rest//[[:space:]]/}" ]]; then uvm_index_args+=(${extra[@]+"${extra[@]}"}); fi
    elif [[ "${line}" =~ ${re_tables} ]]; then
      rest="${BASH_REMATCH[1]}" extra=() ok=1
      while (( ok )) && [[ "${rest}" =~ ${re_table} ]]; do
        entry="${BASH_REMATCH[1]}" rest="${BASH_REMATCH[2]}" url="" dflt=false
        while [[ "${entry}" =~ ${re_pair} ]]; do
          entry="${BASH_REMATCH[3]}"
          case "${BASH_REMATCH[1]}=${BASH_REMATCH[2]}" in
            url=\"*)        url="${BASH_REMATCH[2]}"; url="${url:1:${#url}-2}" ;;
            default=true)   dflt=true ;;
            name=\"*|default=false|explicit=false|format=\"simple\"|authenticate=\"auto\") ;;
            *)              ok=0 ;;
          esac
        done
        if [[ -z "${url}" || -n "${entry//[[:space:]]/}" ]]; then ok=0; fi
        if [[ "${dflt}" == true ]]; then extra+=(--default-index "${url}"); else extra+=(--index "${url}"); fi
      done
      if (( ok )) && [[ -z "${rest//[[:space:]]/}" ]]; then uvm_index_args+=(${extra[@]+"${extra[@]}"}); fi
    fi
  done < "${f}"
}

# Writes a record for each installed tool that has none and still has its
# receipt and pyvenv.cfg, pinned to what is installed now, and never rewrites
# one. A tool installed before records existed, or by a uv the wrapper did not
# run, gets one this way: doctor, every `uv tool` command and the repair's
# holder each call it. The request is uv's own rendering of what was asked
# for, from one `uv tool list` made only when some tool lacks a record, so no
# receipt is parsed for it. A URL in [required: ] is the request; otherwise it
# is the name with its extras and specifier. Each [with: ] item is a --with,
# and one uv renders as a name and a URL becomes `name @ URL`, the form uv
# reads. A URL archive renders no requirement and is recorded by name, which
# its constraint pins to the URL. uv ends a VCS requirement with a
# subdirectory in a newline, so a line whose bracket is still open is joined
# to the next. The indexes come from the receipt (uvm_receipt_indexes). A tool
# uvm_unpinnable refuses is skipped. The list runs from / without the cache,
# so it reads no project configuration and writes nothing under UVM_ROOT but
# uv's lock file, tools/.lock, which it creates when missing (doctor runs it
# only where that file exists). Its output is captured, never printed.
# Returns 0 on every path.
uvm_backfill() {
  local d n missing=0 list line acc="" spec extras with w args
  local re_req='\[required: +([^]]*)\]' re_extras='\[extras: ([^]]*)\]' re_with='\[with: ([^]]*)\]'
  local re_open='\[[^]]*$' re_named='^([A-Za-z0-9._-]+(\[[^]]*\])?) +([A-Za-z][A-Za-z0-9+.-]*://.*)$'
  [[ -n "${uvm_records}" && -d "${UV_TOOL_DIR}" && -x "${real_uv}" ]] || return 0
  for d in "${UV_TOOL_DIR}"/*/; do
    n="${d%/}"; n="${n##*/}"
    if [[ -f "${d}uv-receipt.toml" && -f "${d}pyvenv.cfg" ]] && ! uvm_recorded "${n}"; then missing=1; fi
  done
  (( missing )) || return 0
  list="$(cd / && UV_NO_CACHE=1 exec "${real_uv}" tool list \
          --show-version-specifiers --show-with --show-extras 2>/dev/null)" || return 0
  while IFS= read -r line; do
    if [[ -n "${acc}" ]]; then
      acc+="${line}"
    else
      [[ -n "${line}" && "${line}" != "- "* ]] || continue
      acc="${line}"
    fi
    if [[ "${acc}" =~ ${re_open} ]]; then continue; fi
    line="${acc}" acc=""
    n="${line%% *}"
    if [[ ! -f "${UV_TOOL_DIR}/${n}/uv-receipt.toml" ]] || uvm_recorded "${n}"; then continue; fi
    uvm_unpinnable "${n}"
    [[ -z "${uvm_unpinned}" ]] || continue
    spec="" extras="" with="" args=()
    if [[ "${line}" =~ ${re_req} ]]; then spec="${BASH_REMATCH[1]}"; fi
    if [[ "${line}" =~ ${re_extras} ]]; then extras="${BASH_REMATCH[1]// /}"; fi
    if [[ "${line}" =~ ${re_with} ]]; then with="${BASH_REMATCH[1]}"; fi
    case "${spec}" in
      *://*) args+=("${spec}") ;;
      *)     args+=("${n}${extras:+[${extras}]}${spec}") ;;
    esac
    while [[ -n "${with}" ]]; do
      w="${with%%, *}"
      if [[ "${w}" =~ ${re_named} ]]; then w="${BASH_REMATCH[1]} @ ${BASH_REMATCH[3]}"; fi
      args+=(--with "${w}")
      if [[ "${with}" == *", "* ]]; then with="${with#*, }"; else with=""; fi
    done
    uvm_receipt_indexes "${n}"
    uvm_record_write "${n}" "${args[@]}" ${uvm_index_args[@]+"${uvm_index_args[@]}"}
  done <<< "${list}"
  return 0
}

# ---- argument inspection ---------------------------------------------------
#
# Find the first positional argument, skipping uv's global options and the
# values of those that take one. Used only to recognise `self update` and the
# tool/python commands; everything else is passed through untouched.
#
# The list below is deliberately short. uv's *global* options that take a
# separate value are these five; everything else that looks like one (--python,
# --index-url, --cache-dir, ...) is a per-command option and can only appear
# after the subcommand, where this parser has already stopped looking. A longer
# list is not more careful — it is more surface to drift out of date and more
# arguments to mis-skip.

uvm_global_takes_value() {
  case "$1" in
    --color|--allow-insecure-host|--directory|--project|--config-file) return 0 ;;
    *) return 1 ;;
  esac
}

# Sets uvm_cmd, uvm_subcmd, and uvm_rest (everything after the subcommand).
uvm_parse_command() {
  uvm_cmd=""
  uvm_subcmd=""
  uvm_rest=()
  local seen=0
  while (( $# )); do
    if [[ "$1" == -* ]]; then
      # `shift 2` is all-or-nothing in bash: with one argument left it shifts
      # nothing and returns non-zero, so a trailing value-taking flag would
      # spin this loop forever. Guard on the count instead of swallowing the
      # failure. uv itself will report the missing value.
      if uvm_global_takes_value "$1" && (( $# >= 2 )); then shift 2; else shift; fi
      continue
    fi
    if (( seen == 0 )); then uvm_cmd="$1"; seen=1; shift; continue; fi
    uvm_subcmd="$1"
    shift
    uvm_rest=( ${1+"$@"} )
    return 0
  done
}

# ---- `uv self update` interception -----------------------------------------
#
# The wrapper's uv is installed with UV_UNMANAGED_INSTALL, which suppresses
# the install receipt, which in turn disables the binary's own self-update
# with an unhelpful message. Turn it into a re-provision of our tree instead.

uvm_self_update() {
  local dry_run="" target="" want_help=""
  while (( $# )); do
    case "$1" in
      -h|--help)  want_help=1 ;;
      --dry-run)  dry_run=1 ;;
      --token)    shift || true ;;   # takes a value; never treat it as a version
      --token=*)  ;;
      -*)         ;;
      *)          target="$1" ;;     # positional TARGET_VERSION
    esac
    shift || true
  done

  if [[ -n "${want_help}" ]]; then
    cat <<EOF
Usage: uv self update [TARGET_VERSION]

Intercepted by uv-manager. Re-provisions this user's uv for ${arch} under
${uvm_root} instead of attempting an in-place self-update, which cannot work
for an unmanaged install.

Options:
  --dry-run    Report what would happen and exit
  -h, --help   Show this message

See also: uv-manager install [VERSION], uv-manager versions
EOF
    exit 0
  fi

  if [[ -n "${dry_run}" ]]; then
    printf 'uv-manager: self update intercepted (dry-run) — would refresh %s\n' "${uvm_root}"
    [[ -n "${target}" ]] && printf 'uv-manager: would install version %s\n' "${target}"
    exit 0
  fi

  note "intercepting 'uv self update' -> re-provisioning ${arch} install at ${uvm_root}"
  # A named version is a request to select that version, downloading it only
  # if absent. No version means "go and find out what latest is now".
  if [[ -n "${target}" ]]; then uvm_install "${target}" ""; else uvm_install "" 1; fi
  # exec replaces the process image, so the EXIT trap never runs and a lock
  # still held here would stand until a human removed it. uvm_install
  # has already released its own, which makes this a guard rather than the
  # release; on a path holding no lock it is one builtin test and no fork.
  uvm_unlock
  exec "${real_uv}" --version
}

# ---- uv-manager subcommands ------------------------------------------------

# Emitted through a heredoc rather than a series of printfs so that closing
# stdout early (`uv-manager status | head`) behaves like any other Unix filter.
# bash's printf builtin reports EPIPE as "write error: Broken pipe"; `cat` dies
# quietly on SIGPIPE.
uvm_status() {
  local cur resolved
  cur="$( [[ -L "${uvm_current}" ]] && readlink -- "${uvm_current}" 2>/dev/null || true )"
  resolved="$( [[ -x "${real_uv}" ]] && "${real_uv}" --version 2>/dev/null || echo 'n/a' )"
  cat <<EOF
uv-manager:            ${uvm_version}
invoked as:            ${prog}  ($(abspath "$0"))
architecture:          ${arch}
state root:            ${uvm_base}  (from ${uvm_base_origin})
arch root:             ${uvm_root}
selected version:      ${cur:-<none>}
real uv:               ${real_uv} $( [[ -x "${real_uv}" ]] && echo '[present]' || echo '[MISSING]' )
real uvx:              ${real_uvx} $( [[ -x "${real_uvx}" ]] && echo '[present]' || echo '[MISSING]' )
resolved version:      ${resolved}
installed versions:    $(uvm_list_versions | tr '\n' ' ')
UV_CACHE_DIR:          ${UV_CACHE_DIR}
UV_TOOL_DIR:           ${UV_TOOL_DIR}
UV_TOOL_BIN_DIR:       ${UV_TOOL_BIN_DIR}
UV_PYTHON_INSTALL_DIR: ${UV_PYTHON_INSTALL_DIR}
UV_PYTHON_BIN_DIR:     ${UV_PYTHON_BIN_DIR}
trampoline dirs:       ${uvm_neutral_bin:-<none>}  ${uvm_root_bin}
UVM_DATA:              ${uvm_data:-<none>}  (from ${uvm_data_origin})
XDG_CONFIG_HOME:       ${XDG_CONFIG_HOME:-<unset — user default: ~/.config>}
pin:                   ${pin:-<none — tracks latest>}
EOF
}

uvm_list_versions() {
  local d
  [[ -d "${uvm_versions}" ]] || return 0
  for d in "${uvm_versions}"/*/; do
    [[ -x "${d}uv" ]] || continue
    basename -- "${d%/}"
  done
}

# Scratch purges are per-file on access time, so a tree can be removed
# piecemeal. uv performs no integrity check on an environment it believes is
# installed; it will exec a half-deleted venv and produce an ImportError.
# Look for the damage uv does not notice.
#
# Two counters, under one rule: a FAIL means the tree does not work and sets
# the exit status; a WARN is information about a tree that does work and does
# not. The rule matters more than the current split, because it tells whoever
# adds the next finding which counter it belongs to. Automation keyed on the
# exit status — a job prologue, which README.md recommends — is the reason
# advice must not fail: a tool that runs perfectly well while missing its
# receipt would otherwise hold the status at 1 until someone deleted it.
#
# Findings accumulate into one string and leave through a single `cat`. Every
# document that sends a user here sends them through a pipe as often as not,
# and on `uvm doctor | head` bash's printf builtin reports `write error:
# Broken pipe` once per finding still queued behind the reader that left.
# `cat` dies quietly. The string is expanded once inside the heredoc and not
# rescanned, so a path containing `$` is data rather than an expansion.
#
# The walk is uvm_detect, shared with the purge repair, so the repair acts on
# exactly the damage doctor reports and never on a copy of the walk that has
# drifted from it. uvm_detect sets doctor's findings and both counters, and
# for the repair what each finding calls for: uvm_damaged_tools (an array of
# the damaged tools' directory names), uvm_damaged_pythons (an array of the
# damaged interpreters' install keys) and uvm_orphans (tool names missing
# pyvenv.cfg, one per line); through uvm_detect_records, which runs first,
# uvm_restore_tools (recorded tools a restore rebuilds, which the other passes
# skip) and uvm_absent_tools (recorded tools with no trace here). A finding
# the repair cannot act on sets none of them. It prints nothing; doctor adds
# its own advisories and the report.
uvm_damaged_python() {  # KEY: add an install key once
  case " ${uvm_damaged_pythons[*]-} " in *" $1 "*) return 0 ;; esac
  uvm_damaged_pythons+=("$1")
}

uvm_damaged_tool() {  # NAME: add a tool once
  case " ${uvm_damaged_tools[*]-} " in *" $1 "*) return 0 ;; esac
  uvm_damaged_tools+=("$1")
}

# TOOL: sets uvm_pins to every distribution installed in the tool's
# environment as name==version, read from its dist-info directory names. A
# purge removes files and leaves directories, so these names survive the
# RECORD and METADATA inside them, and they are the only record of the
# versions the tool had: the receipt holds what was asked for, not what was
# resolved. uvm_unrestorable names the first distribution that a version on
# an index cannot restore, one installed from a URL, a git repository or a
# local path, which its direct_url.json records.
uvm_tool_pins() {
  local di dist
  uvm_pins=() uvm_unrestorable=""
  for di in "${uvm_root}/tools/$1"/lib/*/site-packages/*.dist-info; do
    [[ -d "${di}" ]] || continue
    dist="${di##*/}"; dist="${dist%.dist-info}"
    uvm_pins+=("${dist%-*}==${dist##*-}")
    if [[ -z "${uvm_unrestorable}" && -e "${di}/direct_url.json" ]]; then
      uvm_unrestorable="${dist%-*}"
    fi
  done
}

# TOOL: sets uvm_receipt_source to the first entry of the tool's receipt
# that names a source an index cannot stand in for, or to nothing: a
# requirement (the tool or a --with package), a constraint or an override
# from a directory, path, editable, git or URL source. A purge can take
# direct_url.json with the rest of a distribution, and the receipt is then
# the only record that the tool did not come from an index; a reinstall by
# version would replace a fork with upstream, or a private package with a
# public one of the same name. The receipt is read for this and nothing
# else: no spec is built from it, and it is never written.
#
# Its index options are not a refusal. uv writes the index that uv.toml or a
# UV_INDEX variable configures into every receipt, and the repair runs under
# that same configuration, so refusing them would refuse every damaged tool
# at a site with a mirror. An index given on one install's command line alone
# is not applied again; that is conceded.
#
# The match is on the form uv 0.13.6 writes, not on any line that mentions a
# key. Each entry is an inline table on one line, inside the requirements,
# constraints or overrides array of [tool], and a source is one of the five
# keys inside that table. An entrypoint's install-path and a requirement's
# marker are not, so string values are blanked before the keys are matched.
#
# uvm_receipt_sources counts the requirements with a source, the tool and its
# --with packages, each of which uv installed from that source and recorded in
# a direct_url.json. uvm_receipt_reqs holds each one's name, empty where the
# entry names none, and uvm_receipt_reqs_from what to call it; the backfill
# looks for each one's own direct_url.json (uvm_unpinnable).
uvm_tool_receipt() {
  local receipt="${uvm_root}/tools/$1/uv-receipt.toml" line name table="" list=""
  local quoted='^([^"]*)"([^"\\]|\\.)*"(.*)$'
  local named='\{[[:space:]]*name[[:space:]]*=[[:space:]]*"([^"]*)"'
  local header='^[[:space:]]*\[([^]]*)\][[:space:]]*$'
  local start='^[[:space:]]*(requirements|constraints|overrides)[[:space:]]*='
  local source='[{,][[:space:]]*(directory|path|editable|git|url)[[:space:]]*='
  uvm_receipt_source="" uvm_receipt_sources=0 uvm_receipt_reqs=() uvm_receipt_reqs_from=()
  [[ -f "${receipt}" ]] || return 0
  while IFS= read -r line || [[ -n "${line}" ]]; do
    name=""
    if [[ "${line}" =~ ${named} ]]; then name="${BASH_REMATCH[1]}"; fi
    while [[ "${line}" =~ ${quoted} ]]; do line="${BASH_REMATCH[1]}S${BASH_REMATCH[3]}"; done
    line="${line%%#*}"
    if [[ "${line}" =~ ${header} ]]; then
      table="${BASH_REMATCH[1]}" list=""
      continue
    fi
    [[ "${table}" == tool ]] || continue
    if [[ "${line}" =~ ${start} ]]; then list="${BASH_REMATCH[1]}"; fi
    [[ -n "${list}" ]] || continue
    if [[ "${line}" =~ ${source} ]]; then
      if [[ -z "${uvm_receipt_source}" ]]; then
        uvm_receipt_source="${name:-an entry} from its ${BASH_REMATCH[1]} source"
      fi
      if [[ "${list}" == requirements ]]; then
        uvm_receipt_sources=$(( uvm_receipt_sources + 1 ))
        uvm_receipt_reqs+=("${name}")
        uvm_receipt_reqs_from+=("${name:-an entry} from its ${BASH_REMATCH[1]} source")
      fi
    fi
    if [[ "${line}" == *"]" ]]; then list=""; fi
  done < "${receipt}"
}

# NAME: true when NAME is on uvm_restore_tools.
uvm_restoring() {
  case " ${uvm_restore_tools[*]-} " in *" $1 "*) return 0 ;; esac
  return 1
}

# The records, read against this architecture's tree. A recorded tool has a
# trace here when its directory or a shim its record names exists, dangling
# or not. One with a trace that lost what only its record rebuilds, its
# directory, its pyvenv.cfg, its interpreter link, an executable or its
# receipt, goes on uvm_restore_tools, and the passes in uvm_detect leave it
# alone, so none of 0.7.0's refusals reaches a tool that has a record. One
# that lost only files inside its environment is not listed: the in-place arm
# repairs it and keeps its receipt byte for byte, which a restore cannot
# promise. A recorded tool with no trace goes on uvm_absent_tools, one name
# per line, for doctor. The walk never restores one: it was installed for
# another architecture or a cluster sharing UVM_DATA, or removed by hand, and
# restoring every such tool in every job's walk would install each on every
# node type, every download under the lock. Builtins only.
uvm_detect_records() {
  local r name t ep f need trace
  uvm_restore_tools=() uvm_absent_tools="" uvm_record_findings=""
  uvm_record_problems=0 uvm_record_advisories=0
  [[ -n "${uvm_records}" && -d "${uvm_records}" ]] || return 0
  for r in "${uvm_records}"/*/; do
    [[ -f "${r}request" && -f "${r}entrypoints" ]] || continue
    name="${r%/}"; name="${name##*/}"; t="${uvm_root}/tools/${name}"
    trace=0 need=""
    if [[ -d "${t}" ]]; then trace=1; fi
    while IFS= read -r ep || [[ -n "${ep}" ]]; do
      [[ -n "${ep}" ]] || continue
      f="${uvm_root}/bin/shims/${ep}"
      if [[ -e "${f}" || -L "${f}" ]]; then trace=1; fi
      if [[ ! -x "${f}" ]]; then need="its executable ${ep} is missing"; fi
    done < "${r}entrypoints"
    if (( ! trace )); then
      uvm_absent_tools+="${name}"$'\n'
      continue
    fi
    if [[ ! -d "${t}" ]]; then
      need="its directory is gone"
    elif [[ ! -f "${t}/pyvenv.cfg" ]]; then
      need="it has no pyvenv.cfg"
    elif [[ -e "${t}/bin/python" || -L "${t}/bin/python" ]] && [[ ! -x "${t}/bin/python" ]]; then
      need="its interpreter link is broken"
    fi
    # A tool with only its receipt gone still runs, so that is advice, as it
    # is for a tool with no record; the restore puts the receipt back.
    if [[ -n "${need}" ]]; then
      uvm_record_findings+="FAIL  tool ${name} is damaged (${need}); its record restores it"$'\n'
      uvm_record_problems=$(( uvm_record_problems + 1 ))
    elif [[ ! -f "${t}/uv-receipt.toml" ]]; then
      uvm_record_findings+="WARN  tool ${name} has no receipt; its record restores it"$'\n'
      uvm_record_advisories=$(( uvm_record_advisories + 1 ))
    else
      continue
    fi
    uvm_restore_tools+=("${name}")
  done
}

uvm_detect() {
  local problems=0 advisories=0 findings="" d f target name
  uvm_damaged_tools=() uvm_damaged_pythons=() uvm_orphans=""
  uvm_detect_records

  if [[ ! -x "${real_uv}" ]]; then
    findings+="FAIL  uv binary missing: ${real_uv}"$'\n'; problems=$(( problems + 1 ))
  fi

  # Dangling tool/python shims: the target was purged or removed. A shim is
  # a symlink to <dir>/bin/<name>, where <dir> is the tool environment or the
  # interpreter it serves. uv points a python shim at the minor-version link,
  # python/cpython-3.12-<platform>, not at the install it resolves to, so the
  # link is followed to the install's own directory, which is the key the
  # repair names. With that directory still present the repair rebuilds it
  # and the shim resolves again. With the directory removed whole, uv no
  # longer counts that tool or interpreter as installed, so the repair has
  # nothing to rebuild: doctor reports the shim and the repair leaves it,
  # unless the tool has a record, which restores it and owns the finding.
  for d in "${uvm_root}/bin/shims" "${uvm_root}/bin/python-shims"; do
    [[ -d "${d}" ]] || continue
    for f in "${d}"/*; do
      [[ -e "${f}" || -L "${f}" ]] || continue
      if [[ ! -x "${f}" ]]; then
        target="$(readlink -- "${f}" 2>/dev/null || true)"
        if [[ "${d}" != */python-shims && "${target}" == */tools/*/bin/* ]]; then
          name="${target%/bin/*}"; name="${name##*/}"
          if uvm_restoring "${name}"; then continue; fi
        fi
        findings+="FAIL  dangling executable: ${f}"$'\n'; problems=$(( problems + 1 ))
        [[ "${target}" == */bin/* ]] || continue
        target="${target%/bin/*}"; name="${target##*/}"
        if [[ "${d}" != */python-shims ]]; then
          if [[ -d "${uvm_root}/tools/${name}" ]]; then uvm_damaged_tool "${name}"; fi
          continue
        fi
        if [[ -L "${uvm_root}/python/${name}" ]]; then
          target="$(readlink -- "${uvm_root}/python/${name}" 2>/dev/null || true)"
          target="${target%/}"; name="${target##*/}"
        fi
        if [[ -n "${name}" && -d "${uvm_root}/python/${name}" && ! -L "${uvm_root}/python/${name}" ]]; then
          uvm_damaged_python "${name}"
        fi
      fi
    done
  done

  # Tool environments missing their receipt, their virtualenv marker, or their
  # interpreter. The receipt is not damage: the repair reads the environment's
  # own dist-info names, and the receipt only to refuse, so it neither needs
  # one nor writes one.
  if [[ -d "${uvm_root}/tools" ]]; then
    for d in "${uvm_root}/tools"/*/; do
      [[ -d "${d}" ]] || continue
      name="$(basename -- "${d%/}")"
      if uvm_restoring "${name}"; then continue; fi
      # Advisory, not damage: uv ignores a receipt-less directory, but whatever
      # is installed there keeps working when invoked. The line carries its own
      # remedy because a tree with no failures prints no remediation block, and
      # the remedy is --force because the receipt is also what records the
      # entrypoints: a plain reinstall exits 2 on the surviving shim, and
      # deleting the directory alone strands it into a dangling-executable
      # failure this same run would report next time.
      if [[ ! -f "${d}uv-receipt.toml" ]]; then
        findings+="WARN  tool ${name} has no receipt; uv ignores it."
        findings+=" Rebuild it with uv tool install --force ${name},"
        findings+=" or delete the directory and its shim."$'\n'
        advisories=$(( advisories + 1 ))
      fi
      # pyvenv.cfg is what marks the directory as a virtualenv. Without it uv
      # resolves the base interpreter instead, and a repair aimed at this tool
      # installs into that interpreter's site-packages — outside the tree the
      # wrapper owns, and on a shared image outside the user's control. Say so
      # in the finding: this is the one class where the obvious next move is
      # worse than the damage.
      if [[ ! -f "${d}pyvenv.cfg" ]]; then
        findings+="FAIL  tool ${name} has no pyvenv.cfg; no automated repair is safe for it"$'\n'
        problems=$(( problems + 1 ))
        uvm_orphans+="${name}"$'\n'
      fi
      target="${d}bin/python"
      if [[ -e "${target}" || -L "${target}" ]] && [[ ! -x "${target}" ]]; then
        findings+="FAIL  tool ${name} has a broken interpreter link"$'\n'
        problems=$(( problems + 1 )); uvm_damaged_tool "${name}"
      fi
    done
  fi

  # Files missing from inside an environment. uv does not catch this: with a
  # valid receipt it assumes the environment is intact and execs it, and the
  # user gets an ImportError from Python rather than a re-provision. The walk
  # is driven from the dist-info directory rather than the RECORD inside it,
  # because RECORD is read only on uninstall — the coldest file in a
  # distribution, and so an early casualty of an atime-ordered purge. A
  # manifest that is itself gone has to be a finding; globbing for it made the
  # check blind exactly on the trees it exists to catch.
  local di record sp rel missing total tool
  for di in "${uvm_root}"/tools/*/lib/*/site-packages/*.dist-info; do
    [[ -d "${di}" ]] || continue
    tool="${di#"${uvm_root}/tools/"}"; tool="${tool%%/*}"
    if uvm_restoring "${tool}"; then continue; fi
    name="${di##*/}"; name="${name%.dist-info}"
    record="${di}/RECORD"
    sp="${di%/*}"
    if [[ ! -f "${record}" ]]; then
      findings+="FAIL  ${name} has no RECORD manifest (partial purge)"$'\n'
      problems=$(( problems + 1 )); uvm_damaged_tool "${tool}"
      continue
    fi
    missing=0; total=0
    # `read` returns non-zero on a final line with no trailing newline, and
    # RECORD files like that exist; without the guard the loop discards that
    # entry and the walk goes silent on a damaged distribution. Splitting on
    # every comma truncates a quoted path that contains one — the awk this
    # replaced did the same, and correcting it would move the verdict on real
    # trees.
    while IFS=, read -r rel _ || [[ -n "${rel}" ]]; do
      [[ -n "${rel}" ]] || continue
      rel="${rel#\"}"; rel="${rel%\"}"
      case "${rel}" in ../*|/*) continue ;; esac   # scripts outside site-packages
      total=$(( total + 1 ))
      [[ -e "${sp}/${rel}" ]] || missing=$(( missing + 1 ))
    done < "${record}"
    if (( missing > 0 )); then
      findings+="FAIL  ${name} is missing ${missing} of ${total} files (partial purge)"$'\n'
      problems=$(( problems + 1 )); uvm_damaged_tool "${tool}"
    fi
  done

  # Managed interpreters that no longer run. An install is a real directory
  # under python/, and its name is the key the repair names. uv keeps a
  # symlink per minor version beside each install, cpython-3.12-<platform>
  # for cpython-3.12.1-<platform>; the probe runs through both, as it always
  # has, and the repair names only the install, which the symlink resolves
  # to. An install whose binary is gone is damaged too: a purge takes every
  # file of an idle interpreter and leaves its directories and links, and
  # the probe has nothing to run.
  if [[ -d "${uvm_root}/python" ]]; then
    for d in "${uvm_root}/python"/*/; do
      [[ -d "${d}" ]] || continue
      name="$(basename -- "${d%/}")"
      if [[ ! -L "${d%/}" && ! -x "${d}bin/python3" && ! -x "${d}bin/python" ]]; then
        findings+="FAIL  managed interpreter ${name} is damaged (its binary is missing)"$'\n'
        problems=$(( problems + 1 ))
        uvm_damaged_python "${name}"
        continue
      fi
      # No bytecode: doctor writes nothing under UVM_ROOT, and the import
      # would otherwise leave __pycache__ in the interpreter it probes.
      for f in "${d}bin/python3" "${d}bin/python"; do
        [[ -x "${f}" ]] || continue
        if ! PYTHONDONTWRITEBYTECODE=1 "${f}" -c 'import json, os, ssl' >/dev/null 2>&1; then
          findings+="FAIL  managed interpreter ${name} is damaged (stdlib import failed)"$'\n'
          problems=$(( problems + 1 ))
          if [[ ! -L "${d%/}" ]]; then uvm_damaged_python "${name}"; fi
        fi
        break
      done
    done
  fi

  findings="${uvm_record_findings}${findings}"
  problems=$(( problems + uvm_record_problems )) advisories=$(( advisories + uvm_record_advisories ))
  uvm_findings="${findings}" uvm_problems="${problems}" uvm_advisories="${advisories}"
}

# Doctor writes under UVM_DATA and nothing under UVM_ROOT. It records each
# installed tool that has no record and regenerates the record trampolines
# first, so one run after an upgrade leaves every recorded tool restorable and
# reachable by name. The trampolines in UVM_ROOT/bin are under UVM_ROOT, so
# the next sync there writes them, not doctor.
#
# The backfill's `uv tool list` creates uv's lock file, tools/.lock, when it
# is missing, and an access-time purge takes that idle, empty file, so a
# purged tree is exactly where doctor runs. The backfill therefore runs only
# where the lock file already exists; elsewhere doctor names each tool with
# no record and the command that writes one.
uvm_doctor() {
  if [[ -f "${UV_TOOL_DIR}/.lock" ]]; then uvm_backfill >&2 || true; fi
  uvm_trampolines records || true
  uvm_detect
  local problems="${uvm_problems}" advisories="${uvm_advisories}" findings="${uvm_findings}"

  # Advice, both: the tree works without these tools, or with them pinned. A
  # recorded tool with no trace here belongs to another architecture or to a
  # cluster sharing UVM_DATA, or was removed by hand, and a prologue keyed on
  # the exit status must not fail on another node type's tools. A tool
  # restored where its receipt named another tree keeps the pins the replay
  # wrote, so uv tool upgrade leaves it where it is.
  local absent
  while IFS= read -r absent; do
    [[ -n "${absent}" ]] || continue
    findings+="WARN  tool ${absent} is recorded but not installed for ${arch}. Run it by name with"
    findings+=" UVM_REPAIR set to restore it here; uv tool uninstall ${absent}, where it is"
    findings+=" installed, drops the record."$'\n'
    advisories=$(( advisories + 1 ))
  done <<< "${uvm_absent_tools}"
  for absent in "${uvm_root}"/tools/*/.uvm-restored; do
    [[ -e "${absent}" ]] || continue
    absent="${absent%/.uvm-restored}"; absent="${absent##*/}"
    findings+="WARN  tool ${absent} is pinned by a restore: uv tool upgrade leaves it at the restored"
    findings+=" versions. uv tool install --force with its original arguments releases it."$'\n'
    advisories=$(( advisories + 1 ))
  done

  # Advice too: a tool with no record runs, and a purge of it is handled as
  # 0.7.0 handled it. Either the backfill above did not run, because uv's lock
  # file is missing, or it refused the tool, whose source nothing pins now.
  local d
  for d in ${uvm_records:+"${uvm_root}"/tools/*/}; do
    absent="${d%/}"; absent="${absent##*/}"
    [[ -f "${d}uv-receipt.toml" && -f "${d}pyvenv.cfg" ]] || continue
    if uvm_recorded "${absent}"; then continue; fi
    uvm_unpinnable "${absent}"
    if [[ -n "${uvm_unpinned}" ]]; then
      findings+="WARN  tool ${absent} has no record: its receipt records ${uvm_unpinned}, and the"
      findings+=" direct_url.json that pins it is gone, so no record can say what to restore."
      findings+=" Install ${absent} again from that source."$'\n'
    else
      findings+="WARN  tool ${absent} has no record, so nothing restores it after a purge."
      findings+=" uv tool list writes one"
      if [[ ! -f "${UV_TOOL_DIR}/.lock" ]]; then
        findings+="; doctor does not while uv's lock file, ${UV_TOOL_DIR}/.lock, is missing,"
        findings+=" since writing one recreates it"
      fi
      findings+="."$'\n'
    fi
    advisories=$(( advisories + 1 ))
  done

  # A standing lock is advice, never a failure. Every rank sees one while any
  # rank provisions or repairs, so a job prologue keyed on the exit status
  # would fail beside a healthy holder, and a warm tree never consults the
  # lock. The line reports what the lock records and judges nothing: the
  # wrapper never asks whether a holder is alive. It can name the uvm command
  # because this run resolved the same root that `uvm clean` will, and the
  # caution names both kinds of work because that command removes both locks.
  local kind lock holder stray
  for kind in install repair; do
    lock="${uvm_root}/.${kind}.lock"
    [[ -d "${lock}" ]] || continue
    holder=""
    read -r holder 2>/dev/null < "${lock}/owner" || true
    if [[ "${kind}" == install ]]; then
      findings+="WARN  provisioning lock standing: ${lock}"
    else
      findings+="WARN  repair lock standing: ${lock}"
    fi
    findings+=" (owner: ${holder:-<none recorded>})."
    findings+=" Its holder may still be running; once nothing is provisioning or"
    findings+=" repairing this tree, remove it with uvm clean lock --yes."$'\n'
    advisories=$(( advisories + 1 ))
  done

  # Staging copies, which every reader skips, so advice as well. One beside
  # the versions is left by an install killed before it published; one inside
  # a version is left by a call killed after mv nested its copy in a rival's
  # tree and before it removed it. A live install's staging copy looks the
  # same, so the line says it may be one, and nothing here removes it.
  for stray in "${uvm_versions}"/.incoming.* "${uvm_versions}"/*/.incoming.*; do
    [[ -e "${stray}" ]] || continue
    findings+="WARN  staging copy left at ${stray}."
    findings+=" It may belong to an install still running; once nothing is"
    findings+=" provisioning this tree, remove it with rm -rf '${stray}'."$'\n'
    advisories=$(( advisories + 1 ))
  done

  # Failed repair outcomes, also advice: the tree may be fine and the failure
  # about egress or a tool a human has to rebuild. One recorded under a value
  # stands until the value changes, so each gets a line with its reason; the
  # value is decoded from the record's name. One recorded under a Slurm job
  # ended with its job, or with its task in an array, so those are counted on
  # one line and never read: a read refreshes the record's atime and would
  # keep it alive through the purge that is meant to take it. Repaired
  # outcomes are not reported; each is one empty file. A name carrying a +
  # is not a scope's outcome (an encoded scope writes + as _2B): it is a
  # failed restore by name, the scope's name, +tool- and the tool's, and
  # under a value it gets a line of its own naming both. Under a job it is
  # counted with the rest.
  local outcome value rtool reason jobs=0 jobtools=0
  for outcome in "${uvm_root}/.repair"/value-*.failed; do
    [[ -f "${outcome}" ]] || continue
    value="${outcome##*/value-}"; value="${value%.failed}"
    reason=""
    read -r reason 2>/dev/null < "${outcome}" || true
    if [[ "${value}" == *+tool-* ]]; then
      rtool="$(uvm_repair_decode "${value#*+tool-}")"
      value="$(uvm_repair_decode "${value%%+tool-*}")"
      findings+="WARN  restore of tool ${rtool} failed for UVM_REPAIR=${value}: ${reason:-<none recorded>}."
      findings+=" Every call of a command ${rtool} provides with that value fails the same"
      findings+=" way until the value changes; uvm clean outcomes --yes removes this record"
      findings+=" with every other outcome."$'\n'
    else
      value="$(uvm_repair_decode "${value}")"
      findings+="WARN  repair failed for UVM_REPAIR=${value}: ${reason:-<none recorded>}."
      findings+=" Every call with that value fails the same way until the value"
      findings+=" changes; remove the record with uvm clean outcomes --yes."$'\n'
    fi
    advisories=$(( advisories + 1 ))
  done
  for outcome in "${uvm_root}/.repair"/job-*.failed; do
    [[ -f "${outcome}" ]] || continue
    if [[ "${outcome##*/}" == *+tool-* ]]; then
      jobtools=$(( jobtools + 1 ))
    else
      jobs=$(( jobs + 1 ))
    fi
  done
  if (( jobs + jobtools > 0 )); then
    findings+="WARN  ${jobs} failed repair(s) and ${jobtools} failed restore(s) of a tool by name"
    findings+=" recorded under Slurm jobs in ${uvm_root}/.repair. Each belongs to one job,"
    findings+=" or to one task of an array, whose tasks share only a repaired record; a"
    findings+=" new job or task checks the tree and tries each restore again. uvm clean"
    findings+=" outcomes --yes removes them."$'\n'
    advisories=$(( advisories + 1 ))
  fi

  # The delimiters below are unquoted because the findings and the counts
  # interpolate, so no body may contain an unescaped `$` of its own.
  if (( problems == 0 )); then
    # The success line has to stay true when advisories were printed above it.
    if (( advisories > 0 )); then
      cat <<EOF
${findings}OK    no damage detected under ${uvm_root} (${advisories} advisory finding(s) above)
EOF
    else
      cat <<EOF
OK    no damage detected under ${uvm_root}
EOF
    fi
    return 0
  fi

  # The commands are the repair's own, one line per damaged install or tool,
  # interpreters first. The python command names the damaged installs
  # uvm_detect found, because with no target uv installs whatever Python
  # request the reader's working directory, global pin or UV_PYTHON makes, and
  # leaves the damaged interpreter as it was. It is printed only when an
  # install is damaged. A shim whose interpreter cannot be keyed, its install
  # and minor-version link both gone, gets no command, as a shim whose tool
  # is gone gets none: nothing is left to reinstall, and the fallback line
  # below says to remove it. A tool with no pyvenv.cfg gets no command; the
  # paragraph below says why.
  local commands="" pytext="" tooltext="" restoretext="" tool restorable=() replay=0
  if (( ${#uvm_damaged_pythons[@]} > 0 )); then
    commands+="    uv python install --reinstall ${uvm_damaged_pythons[*]}"$'\n'
    pytext="The python command names each damaged interpreter by its directory name under"$'\n'
    pytext+="python/. With no name, uv installs whatever Python a .python-version here or"$'\n'
    pytext+="above, the global pin or UV_PYTHON asks for, and leaves the damaged one as it"$'\n'
    pytext+="was."$'\n\n'
  fi
  for tool in ${uvm_damaged_tools[@]+"${uvm_damaged_tools[@]}"}; do
    [[ -f "${uvm_root}/tools/${tool}/pyvenv.cfg" ]] || continue
    # A recorded tool the in-place repair would refuse is restored, as the
    # repair's own walk does.
    if uvm_recorded "${tool}"; then
      uvm_tool_refusal "${tool}"
      if [[ -n "${uvm_refusal}" ]]; then restorable+=("${tool}"); continue; fi
    fi
    uvm_tool_pins "${tool}"
    uvm_tool_receipt "${tool}"
    if [[ -n "${uvm_unrestorable}" ]]; then
      commands+="    # ${tool}: ${uvm_unrestorable} came from a URL, git or path source;"
      commands+=" install ${tool} again from it"$'\n'
    elif [[ -n "${uvm_receipt_source}" ]]; then
      commands+="    # ${tool}: its receipt records ${uvm_receipt_source};"
      commands+=" install ${tool} again from that source"$'\n'
    elif (( ${#uvm_pins[@]} > 0 )); then
      commands+="    uv pip install --python '${uvm_root}/tools/${tool}/bin/python'"
      commands+=" --reinstall --no-cache ${uvm_pins[*]}"$'\n'
    fi
  done
  if [[ "${commands}" == *"pip install"* || "${commands}" == *"again from"* ]]; then
    tooltext="Each pip command reinstalls every distribution in one damaged tool's
environment at the version its dist-info directory names, so the tool keeps its
version, its --with packages and its receipt, and no other tool changes. It
runs under uv.toml and the UV_ variables, so a configured index or mirror is in
effect; an index given only on the tool's own install command line is not. A
distribution installed from a URL, a git repository or a local path has no
version an index can restore, so a tool whose direct_url.json or receipt
records one gets no command; install that tool again from its source. With
both of those gone the source cannot be known, and the command installs the
index's release of that version.

"
  fi
  # A restore is not a command a human should type: through the wrapper, a
  # replay's -c would become the record's request, and its receipt would pin
  # the tool. A knob-set call runs the restore itself, under the repair lock.
  for tool in ${uvm_restore_tools[@]+"${uvm_restore_tools[@]}"} ${restorable[@]+"${restorable[@]}"}; do
    uvm_restore_request "${tool}"
    if [[ -n "${uvm_restore_local}" ]]; then
      commands+="    # ${tool}: installed from ${uvm_restore_local}, a local source no record keeps;"
      commands+=" install ${tool} again from that source"$'\n'
    else
      commands+="    # ${tool}: restored from ${uvm_records}/${tool} by the call below"$'\n'
      replay=1
    fi
  done
  if (( replay )); then
    commands+="    UVM_REPAIR=\"restore-\$(date +%s)\" uv --version"$'\n'
    restoretext="A call with UVM_REPAIR set restores each tool its record covers: uv tool
install --force replays the request recorded under UVM_DATA with every
distribution pinned to what was installed, on the Python minor it ran on, then
puts uv's receipt back where it names this tree, so uv tool upgrade still moves
the tool. A tool installed from a local source is recorded but never restored.

"
  fi
  if [[ -z "${commands}" ]]; then
    commands="    # nothing above is repaired in place; remove a shim whose tool or interpreter is gone"$'\n'
  fi

  cat <<EOF
${findings}
${problems} problem(s) found. A scratch purge removes files from under a tree uv still
believes is intact, and uv re-checks nothing, so a repair has to bypass its cache:

${commands}
Each command restores what is installed, interpreters first, since every tool
runs on one.

${pytext}${tooltext}${restoretext}Inside a Slurm job, UVM_REPAIR=1 on a uv or uvx call, or on a tool run by its own
name, runs this repair before the command does, once per job.

--no-cache carries the repair: uv runs no integrity check on its unpacked archive
store, so a reinstall that reuses the cache reinstalls the same damage. The python
command needs network access; uv never caches interpreter tarballs. A missing uv
binary needs no command at all — the next uv call re-provisions it and honors
UVM_PIN.

No command repairs a tool with no record whose pyvenv.cfg is gone, and none is
safe to run against one: uv falls back to the base interpreter and writes outside
this tree. Remove that tool's directory and install the tool again, naming the
version you want — the requirement in its receipt may not be the version that was
installed.

Consider pointing UVM_ROOT at non-purged storage instead.
EOF
  return 1
}

uvm_clean() {
  local what="${1:-cache}" confirm="${2:-}"
  local target detail="" holder standing=0 ok=0 failed=0 outcome
  # lock is both locks: the provisioning lock and the repair lock, never the
  # tree beneath them. outcomes is every recorded repair outcome at once.
  # Removing one costs its scope a fresh check and never a false clean, so a
  # form that removes one scope at a time would buy nothing.
  local targets=()
  case "${what}" in
    cache)    targets=("${uvm_root}/cache") ;;
    lock)     targets=("${uvm_root}/.install.lock" "${uvm_root}/.repair.lock") ;;
    outcomes) targets=("${uvm_root}/.repair") ;;
    arch)     targets=("${uvm_root}") ;;
    all)      targets=("${uvm_base}") ;;
    *)        die "clean: expected one of: cache, lock, outcomes, arch, all" ;;
  esac
  if [[ "${confirm}" != "--yes" ]]; then
    for target in "${targets[@]}"; do
      detail+="Would remove: ${target}"$'\n'
      if [[ ! -e "${target}" ]]; then
        detail+="(absent)"$'\n'
      elif [[ "${what}" == lock ]]; then
        # A lock's size says nothing; what it records and what removing it
        # costs do.
        holder=""
        read -r holder 2>/dev/null < "${target}/owner" || true
        detail+="owner: ${holder:-<none recorded>}"$'\n'
        standing=1
      elif [[ "${what}" == outcomes ]]; then
        # Counted by name and never opened, so a dry run refreshes no
        # record's atime.
        for outcome in "${target}"/*.ok; do
          [[ -f "${outcome}" ]] || continue
          ok=$(( ok + 1 ))
        done
        for outcome in "${target}"/*.failed; do
          [[ -f "${outcome}" ]] || continue
          failed=$(( failed + 1 ))
        done
        detail+="${ok} repaired and ${failed} failed repair outcome(s).
Removing a repaired one costs its scope a fresh check, never a false clean,
and removing a failed one lets its scope try the repair again. A call
repairing now fails to record its outcome, and the next call in its scope
repairs again, so remove them once nothing is repairing this tree.
"
      else
        detail+="$(du -sh "${target}" 2>/dev/null || echo '(absent)')"$'\n'
      fi
    done
    # Clearing a lock is the one removal the wrapper leaves to a human, and
    # against a live holder it does not stop at one extra call: each release
    # removes whatever lock the next call took.
    if (( standing )); then
      detail+="A holder may still be running. If one is, removing its lock lets another
call take the lock and provision or repair beside it, and the holder's own
release then removes that call's lock, and so on down the line of waiters.
Remove a lock only once nothing is provisioning or repairing this tree.
"
    fi
    # Heredoc rather than printfs, for the same reason as uvm_status: `cat`
    # dies quietly on SIGPIPE where bash's printf reports EPIPE.
    cat <<EOF
${detail}Re-run with --yes to proceed.
EOF
    return 0
  fi
  for target in "${targets[@]}"; do
    [[ -e "${target}" ]] || continue
    note "removing ${target}"
    rm -rf "${target}"
  done
}

uvm_help() {
  cat <<EOF
uv-manager ${uvm_version} — site launcher for uv on multi-architecture clusters

Usage: uv-manager <command> [args]

  status              Show every resolved path and the selected uv version
  doctor              Check for a partially purged / damaged tree
  versions            List uv versions installed for this architecture
  install [VERSION]   Select VERSION, downloading it if absent.
                      With no VERSION, re-resolve latest from the network.
  trampolines         Regenerate the architecture-neutral trampolines that
                      run installed tools by name: UVM_DATA/bin for the
                      recorded ones, UVM_ROOT/bin for the rest
  clean [WHAT] --yes  Remove cache (default), lock (both locks), outcomes
                      (recorded repair outcomes), arch tree, or all
  help                This message

Environment:
  UVM_ROOT            Base directory for per-user uv state (set by the module)
  UVM_DATA            Durable directory for what each installed tool was
                      installed from, a few KB per tool, off scratch
                      (default: \${XDG_DATA_HOME:-\$HOME/.local/share}/uvm)
  UVM_PIN             uv version to provision and select
  UVM_PLATFORM        Override the architecture key (default: uname -m)
  UVM_INSTALL_URL     Installer base URL, for sites mirroring Astral
  UVM_LOCK_TIMEOUT    Seconds to wait for a lock. Past it, provisioning installs
                      without the lock and a repair fails (default: 180)
  UVM_REPAIR          On a uv or uvx call, or an installed tool run by its
                      own name, repair what a scratch purge removed and
                      restore installed tools from their records before the
                      command runs, once per Slurm job, else once per value;
                      a tool run by its own name is restored even on an
                      architecture it was never installed for. Off
                      when unset, empty or 0; any other value, 00 and false
                      included, is on. Outside a job, give a per-run value,
                      at most 194 bytes, each byte outside a-z 0-9 . -,
                      an uppercase letter included, counting as three.
                      README.md, "Repairing inside a job", says what it
                      repairs, what it needs and why.

'uvm' is a short alias for 'uv-manager'. The same script is also installed as
'uv' and 'uvx', which pass through to the real uv for this node's architecture.
EOF
}

uvm_manager_main() {
  local cmd="${1:-status}"
  shift || true

  # help and --version are the reason uvm_init is deferred: they must work
  # where no state root is configured, because they are what tell you how to
  # set one. _trampoline is a trampoline's way in, and runs uvm_init itself.
  case "${cmd}" in
    help|-h|--help) uvm_help; return 0 ;;
    --version)      printf '%s\n' "${uvm_version}"; return 0 ;;
    _trampoline)    uvm_tool_entry "$@" ;;
  esac

  uvm_init
  case "${cmd}" in
    status)      uvm_set_paths; uvm_status ;;
    versions)    uvm_list_versions ;;
    doctor)      uvm_set_paths; uvm_doctor ;;
    clean)       uvm_clean "${1:-cache}" "${2:-}" ;;
    trampolines) uvm_export_env; uvm_trampolines; uvm_trampolines_report ;;
    install)     if [[ -n "${1:-}" ]]; then uvm_install "$1" ""; else uvm_install "" 1; fi
                 uvm_export_env; uvm_trampolines
                 note "selected $("${real_uv}" --version 2>/dev/null || echo '?')" ;;
    *)           die "unknown command: ${cmd} (try: uv-manager help)" ;;
  esac
}

# ---- restore from a record -------------------------------------------------
#
# A record rebuilds what a purge leaves the in-place repair nothing to act on:
# a tool that lost its directory, its pyvenv.cfg, its interpreter link, an
# executable or its receipt, and a tool the in-place arm refuses, a git, URL
# or path source among them. The restore replays the record: `uv tool install
# --force` of the request as typed, with the record's constraints pinning
# every distribution, a VCS one to its commit, on an interpreter of the
# recorded minor. Pins are constraints, not requirements, so they add no
# package and resolution stays the user's: uv.toml and the UV_ variables
# apply, and the replay runs from / in a subshell, as the repair arms do, so
# the job's project configuration does not. --force is what puts a missing
# shim back; without it uv reports the tool installed and changes nothing.
# The cache is bypassed, because uv runs no integrity check on it.
#
# The replay's receipt carries the pins, which would hold the tool against
# `uv tool upgrade` where nothing held it before. The record keeps uv's own
# receipt byte for byte, so that copy goes back in place of the replay's when
# every install-path it records names this tree's shim directory. One naming
# another architecture's or another root's directory would point uv at
# entrypoints this tree does not have, so there the replay's receipt stays,
# and a .uvm-restored file in the tool's directory tells doctor the tool is
# pinned by a restore; `uv tool install --force` with the original arguments
# recreates the directory without it. The test counts fixed strings and
# parses nothing. This is the one place the wrapper writes a receipt, and
# what it writes is uv's own. The record itself is read, never written.

# TOOL: sets uvm_restore_args to the replay's arguments from TOOL's recorded
# request, and uvm_restore_local to the local source it names, or to nothing.
# The request is opaque except for three classes of token, and is not a model
# of uv's command line. --force is dropped, because the replay adds its own
# and uv refuses a repeated flag. <name>[extras]@latest loses @latest, which
# uv resolves to the newest release before it reads the pins and which then
# conflicts with them. An option naming a local file or directory marks a
# source the wrapper does not keep, which a replay from / could not reach
# anyway; so does a constraint on a file: URL, which a path source records.
uvm_restore_request() {
  local a r="${uvm_records}/$1" re_latest='^([A-Za-z0-9._-]+(\[[^]]*\])?)@latest$'
  uvm_restore_args=() uvm_restore_local=""
  while IFS= read -r a || [[ -n "${a}" ]]; do
    case "${a}" in
      --force) continue ;;
      -e|--editable|--editable=*|--with-editable|--with-editable=*|--with-requirements|--with-requirements=*\
      |-c|--constraints|--constraints=*|--overrides|--overrides=*|-b|--build-constraints|--build-constraints=*)
        if [[ -z "${uvm_restore_local}" ]]; then uvm_restore_local="${a%%=*}"; fi ;;
    esac
    if [[ "${a}" =~ ${re_latest} ]]; then a="${BASH_REMATCH[1]}"; fi
    uvm_restore_args+=("${a}")
  done < "${r}/request"
  if [[ -z "${uvm_restore_local}" ]] && grep -q ' @ file:' "${r}/constraints" 2>/dev/null; then
    uvm_restore_local="a path"
  fi
}

# TOOL: restores TOOL from its record. Returns 1 with uvm_repair_reason set
# when it refuses a local source or the replay fails, so the repair arm that
# called it can end the walk with that reason. Every byte goes to stderr.
uvm_restore() {
  local tool="$1" r="${uvm_records}/$1" t="${UV_TOOL_DIR}/$1" py="" line n_all=0 n_here=0
  uvm_restore_request "${tool}"
  if [[ -n "${uvm_restore_local}" ]]; then
    uvm_repair_reason="tool ${tool} was installed from ${uvm_restore_local}, a local source no record"
    uvm_repair_reason+=" keeps; install it again from that source"
    return 1
  fi
  read -r py 2>/dev/null < "${r}/python" || true
  # The minor as UV_PYTHON rather than --python: a request's own --python then
  # wins, uv refuses it twice, and no .python-version or global pin steers the
  # replay onto another interpreter.
  if ! (
    cd / || exit 1
    if [[ -n "${py}" ]]; then export UV_PYTHON="${py}"; fi
    UV_NO_CACHE=1 exec "${real_uv}" tool install --force -c "${r}/constraints" \
      ${uvm_restore_args[@]+"${uvm_restore_args[@]}"}
  ) >&2; then
    uvm_repair_reason="the restore of tool ${tool} from its record failed"
    return 1
  fi
  if [[ -f "${r}/uv-receipt.toml" ]]; then
    while IFS= read -r line || [[ -n "${line}" ]]; do
      [[ "${line}" == *'install-path = "'* ]] || continue
      n_all=$(( n_all + 1 ))
      if [[ "${line}" == *"install-path = \"${UV_TOOL_BIN_DIR}/"* ]]; then n_here=$(( n_here + 1 )); fi
    done < "${r}/uv-receipt.toml"
  fi
  if (( n_all > 0 && n_all == n_here )) \
     && cp "${r}/uv-receipt.toml" "${t}/.uv-receipt.toml.$$" \
     && mv -f "${t}/.uv-receipt.toml.$$" "${t}/uv-receipt.toml"; then
    return 0
  fi
  rm -f "${t}/.uv-receipt.toml.$$" 2>/dev/null || true
  : > "${t}/.uvm-restored" 2>/dev/null || true
  return 0
}

# ---- purge repair ----------------------------------------------------------
#
# UVM_REPAIR asks a uv or uvx call to repair what a scratch purge removed
# before it runs the command. It fires here, inside the call, after uvm_init
# has resolved the platform key on the node that will run the command, so it
# repairs the tree that command uses. A step outside the job, a login-node
# prologue say, repairs the login node's architecture instead.
#
# An outcome records that a check ran in a scope, never that the tree is
# intact: the purge can take a file the moment after. Inside Slurm the scope
# is the job. Every step of an allocation shares SLURM_JOB_ID, so a job checks
# the tree once, and its record ends with the job. An array task, which Slurm
# marks with SLURM_ARRAY_TASK_ID, shares a repaired record with the rest of its
# array, keyed on SLURM_ARRAY_JOB_ID, so a large array
# does not walk the tree once per task under the repair lock; the cost is
# that a purge landing partway through the array goes unchecked by the tasks
# that start after it. A failed record is the task's own, keyed on its
# SLURM_JOB_ID: sharing it would buy nothing, and a failure on transient
# egress would stop every later task, days later perhaps, without a try. So
# the next task checks again. SLURM_CLUSTER_NAME is the job id's namespace:
# two clusters sharing a filesystem and an architecture issue the same ids,
# and without it one cluster's record would read as a check on the other's
# job. Outside a job the scope is the knob's literal value. An outcome is only
# ever tested, never read, so its atime is its creation time, and under a
# constant value the purge can take older tool files while the record
# survives, which reads as clean on a damaged tree. A per-run value avoids it.
#
# One call per scope detects and repairs, holding the repair lock; the rest
# wait on it, and their predicate is the arrival test: is an outcome recorded
# for this scope? The holder records before it releases, so a waiter that
# sees the lock go also sees the outcome. A failed outcome ends the scope's
# attempts: every call in it exits with the holder's reason, rather than each
# waiter in turn winning the lock and repeating a deterministic failure until
# its timeout. In an array the predicate tests the array's repaired record and
# the task's own failed one, so a waiter passes on any task's repair, and
# after another task's holder fails it takes the lock and tries itself. A
# holder that dies records nothing, and its waiters fail at UVM_LOCK_TIMEOUT
# naming the lock, which only a human removes.
#
# The record's name is the scope with every byte outside a-z, 0-9, . and -
# written as _ and two hex digits, _ and every uppercase letter included, so
# two values never share a name: run/1, run 1, run_1 and run:1 are four
# scopes, and Run1 and run1 are two even where the filesystem ignores case,
# as macOS's does by default. The class is
# spelled out, not ranged: before bash 5.0 a range follows the locale's
# collation, so a-z admits accented letters under UTF-8 on one version and
# not on the next. The loop runs under LC_ALL=C, so that it walks bytes, not
# a multibyte locale's characters, and puts the caller's locale back after.

uvm_repair_ok=""
uvm_repair_failed=""
uvm_repair_reason=""
uvm_repair_name=""
uvm_repair_scope=""

# SCOPE: sets uvm_repair_name to SCOPE written as a record name. Builtins
# only, since a call with the knob set and an outcome recorded runs this and
# nothing else of note before its command. printf -v is one.
uvm_repair_encode() {
  local in="$1" out="" c n i lc_all="${LC_ALL-}" lc_set="${LC_ALL+1}"
  LC_ALL=C
  for (( i = 0; i < ${#in}; i++ )); do
    c="${in:i:1}"
    case "${c}" in
      [abcdefghijklmnopqrstuvwxyz0123456789.-]) out+="${c}" ;;
      *) printf -v n '%d' "'${c}"; printf -v c '_%02X' $(( n & 255 )); out+="${c}" ;;
    esac
  done
  if [[ -n "${lc_set}" ]]; then LC_ALL="${lc_all}"; else unset LC_ALL; fi
  uvm_repair_name="${out}"
}

# NAME: prints the scope a record name encodes, for doctor.
uvm_repair_decode() {
  local in="$1" out="" c
  while [[ -n "${in}" ]]; do
    c="${in%%_*}"; out+="${c}"; in="${in#"${c}"}"
    [[ -n "${in}" ]] || break
    printf -v c '%b' "\\x${in:1:2}"; out+="${c}"; in="${in:3}"
  done
  printf '%s' "${out}"
}

# The waiter's predicate, and the test a call makes on arrival.
uvm_repair_recorded() {
  [[ -e "${uvm_repair_ok}" || -e "${uvm_repair_failed}" ]]
}

# Detect, then run the arms the damage calls for, in order: the interpreters,
# the restore of recorded tools, the in-place repair of the rest. Each arm
# that fails sets uvm_repair_reason and returns, and the walk with it. Sets
# uvm_repair_reason on failure, and returns 0 either way, so that it runs
# under errexit: a fault in the walk then ends the call, as a dead holder
# does, rather than letting it go on to record an outcome. Everything goes to
# stderr, uv's output included, because stdout belongs to the command the
# user asked for.
#
# A repair restores what is installed and never applies the job's Python
# request. The job may carry one in a .python-version in the working directory
# or above it, in the global pin under XDG_CONFIG_HOME, or in UV_PYTHON, and
# each arm names its targets so that none of the three reaches it (measured
# with uv 0.13.6). The interpreter reinstall with no target installs what any
# of the three asks for, exits 0 and leaves the damaged interpreter as it was;
# a named install key overrides all three. The tool arm names the tool's own
# interpreter with --python, which overrides UV_PYTHON, the only one of the
# three a pip install reads.
#
# Nor does it apply the project configuration of the job's working directory.
# uv reads [tool.uv] and [tool.uv.pip] in a pyproject.toml, and a uv.toml, from
# the working directory and every directory above it, and a job usually starts
# in its project: a pip target there sends the reinstall into the project, and
# an exclude-newer there hides the versions the tool holds. So each arm runs
# from /, in a subshell, leaving the command's own directory as it was. The
# user's and the system's uv.toml and the UV_ variables still apply, which
# --no-config would not allow. Every path an arm passes is under UVM_ROOT, so
# a relative UVM_ROOT fails the repair here.
uvm_repair_run() {
  local line first tool rc=0
  uvm_repair_reason=""
  uvm_detect
  while IFS= read -r line; do
    [[ -z "${line}" ]] || note "${line}"
  done <<< "${uvm_findings}"

  # A tool directory without pyvenv.cfg is no longer a virtualenv, and uv
  # resolves the base interpreter in its place. The tool arm then exits 0
  # while it installs that tool into the base interpreter's site-packages and
  # retargets its shim there, outside this tree, so uv gives no signal and
  # this refusal is the only guard. It comes before every arm: the scope fails
  # and nothing is rebuilt until a human removes the directory.
  if [[ -n "${uvm_orphans}" ]]; then
    first="${uvm_orphans%%$'\n'*}"
    uvm_repair_reason="tool ${first} has no pyvenv.cfg, so no automated repair is safe;"
    uvm_repair_reason+=" remove ${uvm_root}/tools/${first} and install the tool again"
    return 0
  fi

  # Interpreters before tools: a tool environment runs on a managed
  # interpreter, and the tool arm fails on one that cannot import its
  # stdlib, repairing nothing.
  if (( ${#uvm_damaged_pythons[@]} > 0 )); then
    note "repairing the managed interpreters for ${arch}"
    # Each target is an install key, the directory's name under python/,
    # which carries the patch version, so uv reinstalls exactly that
    # interpreter at exactly that version. It needs no --no-cache: uv does
    # not cache interpreter downloads.
    (cd / && exec "${real_uv}" python install --reinstall "${uvm_damaged_pythons[@]}") >&2 || rc=$?
    if (( rc != 0 )); then
      uvm_repair_reason="the managed interpreter repair failed (uv exited ${rc})"
      return 0
    fi
  fi

  # Recorded tools, from their records. A damaged recorded tool the in-place
  # arm below would refuse joins them here, after the interpreter arm, since
  # whether its bin/python runs is one of the refusals. The in-place arm stays
  # the first choice for every other damaged tool, recorded or not: it leaves
  # the receipt byte for byte, where a restore puts back a copy only when it
  # names this tree. The first refusal or failure ends the walk with its
  # reason.
  for tool in ${uvm_damaged_tools[@]+"${uvm_damaged_tools[@]}"}; do
    if uvm_restoring "${tool}" || ! uvm_recorded "${tool}"; then continue; fi
    uvm_tool_refusal "${tool}"
    if [[ -n "${uvm_refusal}" ]]; then uvm_restore_tools+=("${tool}"); fi
  done
  if (( ${#uvm_restore_tools[@]} > 0 )); then
    note "restoring the installed tools for ${arch} from their records: ${uvm_restore_tools[*]}"
    for tool in "${uvm_restore_tools[@]}"; do
      uvm_restore "${tool}" || return 0
    done
  fi

  # Each damaged tool, and no other, gets every distribution in its
  # environment reinstalled at the version its dist-info directory names,
  # into that environment. uv's tool commands cannot do this: an upgrade
  # moves an unpinned tool, or any unpinned dependency or --with package, to
  # the newest release, and moving a version means uninstalling the old one,
  # which needs the RECORD a purge takes first; a reinstall from the receipt
  # rewrites the receipt. Here the receipt is read only to refuse and never
  # written, so a tool keeps its pin, its --with packages and its receipt
  # byte for byte, and a healthy tool is never touched. Dependencies are resolved, not
  # skipped: with every version pinned the resolver moves nothing, and it
  # restores a dependency whose whole dist-info directory went with the
  # purge. --no-cache carries the repair: uv runs no integrity check on its
  # unpacked archive store, so a reinstall that reuses the cache reinstalls
  # the same damage.
  local inplace=()
  for tool in ${uvm_damaged_tools[@]+"${uvm_damaged_tools[@]}"}; do
    if ! uvm_restoring "${tool}"; then inplace+=("${tool}"); fi
  done
  (( ${#inplace[@]} > 0 )) || return 0
  note "repairing the tool environments for ${arch}: ${inplace[*]}"
  for tool in "${inplace[@]}"; do
    uvm_tool_refusal "${tool}"
    if [[ -n "${uvm_refusal}" ]]; then
      uvm_repair_reason="${uvm_refusal}"
      return 0
    fi
    if ! (cd / && exec "${real_uv}" pip install --python "${uvm_root}/tools/${tool}/bin/python" \
         --reinstall --no-cache "${uvm_pins[@]}") >&2; then
      uvm_repair_reason="the tool environment repair failed for ${tool}"
      return 0
    fi
  done
  return 0
}

# TOOL: sets uvm_refusal to the reason the in-place arm cannot repair TOOL,
# or to nothing, and uvm_pins to what it would reinstall.
uvm_tool_refusal() {
  local tool="$1"
  uvm_refusal=""
  # --python must name the tool's own environment. pyvenv.cfg is what makes
  # bin/python that environment's interpreter rather than the base one, and
  # the interpreter arm has already restored what bin/python points at, so
  # an interpreter that still does not run is gone for good.
  if [[ ! -f "${uvm_root}/tools/${tool}/pyvenv.cfg" || ! -x "${uvm_root}/tools/${tool}/bin/python" ]]; then
    uvm_refusal="tool ${tool} has no interpreter at bin/python, so no automated repair is safe;"
    uvm_refusal+=" remove ${uvm_root}/tools/${tool} and install the tool again"
    return 0
  fi
  uvm_tool_pins "${tool}"
  if [[ -n "${uvm_unrestorable}" ]]; then
    uvm_refusal="tool ${tool} has ${uvm_unrestorable} from a URL, git or path source, which no"
    uvm_refusal+=" version on an index restores; install the tool again from that source"
    return 0
  fi
  # The same refusal when the purge took direct_url.json too, read from the
  # receipt.
  uvm_tool_receipt "${tool}"
  if [[ -n "${uvm_receipt_source}" ]]; then
    uvm_refusal="tool ${tool} has ${uvm_receipt_source} in its receipt, which no version on"
    uvm_refusal+=" an index restores; install the tool again from that source"
    return 0
  fi
  if (( ${#uvm_pins[@]} == 0 )); then
    uvm_refusal="tool ${tool} records no installed distribution to restore;"
    uvm_refusal+=" remove ${uvm_root}/tools/${tool} and install the tool again"
  fi
  return 0
}

uvm_repair() {
  local ok failed scope reason="no outcome was recorded" after dir="${uvm_root}/.repair"
  if [[ -n "${SLURM_JOB_ID:-}" ]]; then
    scope="Slurm job ${SLURM_JOB_ID}"
    uvm_repair_encode "job-${SLURM_CLUSTER_NAME:+${SLURM_CLUSTER_NAME}-}${SLURM_JOB_ID}"
    failed="${uvm_repair_name}" ok="${uvm_repair_name}"
    after="Every call in this job fails the same way; the record ends with the job."
    # An array's first task has SLURM_JOB_ID equal to SLURM_ARRAY_JOB_ID, so
    # the task id, not a difference between the two, says this is an array.
    if [[ -n "${SLURM_ARRAY_TASK_ID:-}" ]]; then
      uvm_repair_encode "job-${SLURM_CLUSTER_NAME:+${SLURM_CLUSTER_NAME}-}${SLURM_ARRAY_JOB_ID:-${SLURM_JOB_ID}}"
      ok="${uvm_repair_name}"
      after="Every call in this array task fails the same way; the record ends with"
      after+=" the task, and the array's next task checks again."
    fi
  else
    scope="UVM_REPAIR=${UVM_REPAIR}"
    uvm_repair_encode "value-${UVM_REPAIR}"
    ok="${uvm_repair_name}" failed="${uvm_repair_name}"
    after="Every call with this value fails the same way until the value changes."
  fi
  # NAME_MAX is 255 bytes and the record adds a suffix. Past it, every write
  # of an outcome would fail after the repair had run, and each waiter in turn
  # would run it again; truncating would let two long values share a scope.
  # The prefix keeps the name from starting with - or being . or ..
  (( ${#ok} <= 200 && ${#failed} <= 200 )) \
    || die "UVM_REPAIR is too long: its record name would be ${#ok} bytes, and the limit is 200"
  uvm_repair_ok="${dir}/${ok}.ok"
  uvm_repair_failed="${dir}/${failed}.failed"
  uvm_repair_scope="${scope}"

  # The repaired path costs this one stat.
  [[ -e "${uvm_repair_ok}" ]] && return 0

  # uvm_install's shape: not recorded on arrival, not recorded by the holder
  # this call waited on (the lock returns 1 when its predicate came true), and
  # still not recorded once the lock is won, since the holder may have
  # recorded and released between this call's last poll and its mkdir. The
  # walk runs only past all three. A waiter at the timeout dies inside the
  # lock and runs nothing.
  if ! uvm_repair_recorded &&
     uvm_acquire_lock repair fail uvm_repair_recorded &&
     ! uvm_repair_recorded; then
    (umask 077; mkdir -p "${dir}") || die "cannot create ${dir}"
    # Records first, for tools that have none, so a user who only runs jobs
    # after an upgrade still gets them before the walk reads them, and their
    # trampolines with them: a record and its trampoline are written as one
    # step, and a record whose trampoline is missing leaves the tool "command
    # not found" once a purge takes the shim. The sync is the record
    # directory's alone, once per scope, and runs whether or not the backfill
    # wrote anything, so a record some earlier write left without its
    # trampoline gets one too.
    uvm_backfill >&2 || true
    uvm_trampolines records >&2 || true
    uvm_repair_run
    # The failed record is written whole under a temporary name and renamed,
    # because a waiter reads its reason the moment the name appears. The
    # repaired record is empty, so its existence is all there is to write.
    if [[ -z "${uvm_repair_reason}" ]]; then
      : > "${uvm_repair_ok}" || die "cannot record the repair outcome at ${uvm_repair_ok}"
    else
      { printf '%s\n' "${uvm_repair_reason}" > "${uvm_repair_failed}.$$" &&
        mv -f "${uvm_repair_failed}.$$" "${uvm_repair_failed}"; } \
        || die "cannot record the repair outcome at ${uvm_repair_failed}"
    fi
  fi
  uvm_unlock

  [[ -e "${uvm_repair_ok}" ]] && return 0
  read -r reason 2>/dev/null < "${uvm_repair_failed}" || true
  die "the repair for ${scope} failed: ${reason}
    ${after}"
}

# ---- restore by name -------------------------------------------------------
#
# The walk restores only a recorded tool with a trace in this tree. One with
# none was installed for another architecture, on a cluster sharing UVM_DATA,
# or removed by hand, and restoring every such tool in every job's walk would
# install each on every node type, every download under the lock. So it comes
# back only where it is run by its own name with the knob set: the trampoline
# whose shim is still missing after the scope check restores that tool, and
# no other, under the repair lock: its second caller, with its own predicate.
#
# Success is its own evidence, the shim executable again, and the waiters'
# predicate tests exactly that, so nothing is recorded for it. Nothing stale
# can read as clean either, since this path is entered only when the shim is
# missing. A failure is recorded per scope and tool, as the scope's failed
# record with +tool-<encoded tool> before .failed, so the calls waiting on it
# fail at once with its reason rather than at UVM_LOCK_TIMEOUT, and it lasts
# as that record does: a job's, an array task's own, a value's until the value
# changes. An encoded scope writes + as _2B, so the two names never collide,
# and doctor tells them apart by it.

uvm_ondemand_shim=""
uvm_ondemand_failed=""

# The waiter's predicate, and the test a call makes on arrival and once it
# holds the lock.
uvm_ondemand_done() {
  [[ -x "${uvm_ondemand_shim}" || -e "${uvm_ondemand_failed}" ]]
}

# NAME: restores the recorded tool whose entrypoints name NAME, after
# uvm_repair has named the scope's records. Returns 0 with NAME's shim in
# place, or when no record names NAME, which leaves the caller to say so;
# dies with the recorded reason when the restore failed.
uvm_restore_by_name() {
  local name="$1" tool="" f ep base after reason="no outcome was recorded"
  for f in ${uvm_records:+"${uvm_records}"/*/entrypoints}; do
    [[ -f "${f}" ]] || continue
    while IFS= read -r ep || [[ -n "${ep}" ]]; do
      if [[ "${ep}" == "${name}" ]]; then tool="${f%/entrypoints}"; tool="${tool##*/}"; break 2; fi
    done < "${f}"
  done
  [[ -n "${tool}" ]] || return 0
  uvm_repair_encode "${tool}"
  uvm_ondemand_shim="${UV_TOOL_BIN_DIR}/${name}"
  uvm_ondemand_failed="${uvm_repair_failed%.failed}+tool-${uvm_repair_name}.failed"
  # NAME_MAX is 255 bytes, and the temporary name adds a dot and a pid.
  base="${uvm_ondemand_failed##*/}"
  (( ${#base} <= 240 )) \
    || die "cannot restore ${tool}: its record name would be ${#base} bytes, and the limit is 240"

  # uvm_repair's shape: not done on arrival, not done by the holder this call
  # waited on, and still not done once the lock is won.
  if ! uvm_ondemand_done &&
     uvm_acquire_lock repair fail uvm_ondemand_done &&
     ! uvm_ondemand_done; then
    note "restoring the installed tool ${tool} for ${arch} from its record"
    uvm_repair_reason=""
    if uvm_restore "${tool}" && [[ ! -x "${uvm_ondemand_shim}" ]]; then
      uvm_repair_reason="tool ${tool} was restored from its record and provides no ${name}"
    fi
    # The restored tool's record trampolines, as wherever a record is acted
    # on, so the next call by name finds one in $UVM_DATA/bin.
    uvm_trampolines records >&2 || true
    # Written whole under a temporary name and renamed, because a waiter
    # reads its reason the moment the name appears.
    if [[ -n "${uvm_repair_reason}" ]]; then
      { (umask 077; mkdir -p "${uvm_ondemand_failed%/*}") &&
        printf '%s\n' "${uvm_repair_reason}" > "${uvm_ondemand_failed}.$$" &&
        mv -f "${uvm_ondemand_failed}.$$" "${uvm_ondemand_failed}"; } \
        || die "cannot record the restore outcome at ${uvm_ondemand_failed}"
    fi
  fi
  uvm_unlock

  [[ -x "${uvm_ondemand_shim}" ]] && return 0
  read -r reason 2>/dev/null < "${uvm_ondemand_failed}" || true
  if [[ -n "${SLURM_JOB_ID:-}" ]]; then
    after="Every call of ${name} in this job fails the same way; the record ends with the job."
  else
    after="Every call of ${name} with this value fails the same way until the value changes."
  fi
  die "cannot run ${name} for ${uvm_repair_scope}: ${reason}
    ${after}"
}

# ---- dispatch --------------------------------------------------------------

if [[ "${mode}" == "manager" ]]; then
  uvm_manager_main "$@"
  exit $?
fi

uvm_init

uvm_cmd=""
uvm_subcmd=""
uvm_rest=()
uvm_parse_command "$@"

uvm_ensure_uv
uvm_export_env

# The first call after an upgrade syncs the trampolines, once per root. Until
# it does, a tool runs through its 0.7.0 trampoline in $UVM_ROOT/bin, which
# the module keeps on PATH and which the sync rewrites in place; waiting for a
# user to run `uv tool` or doctor would leave that until whenever they did.
#
# The trigger is this root's marker, in this root's directory and written only
# here and by a sync of that directory. $UVM_DATA/bin cannot serve: doctor
# creates it and never writes under UVM_ROOT, and another root sharing
# UVM_DATA creates it first, and either would leave this root's 0.7.0
# trampolines unrewritten. The call creates the marker before it syncs, and
# skips the sync when it cannot: a directory that cannot be created or
# written, or an inode quota, would otherwise cost a full sync on every call
# that could never leave a marker. A sync that then fails to write this
# root's directory removes the marker, so the next call tries again, one
# attempt per call while it fails. An unwritable UVM_DATA costs nothing
# further: the root's directory syncs and the marker stays. While the marker
# exists this is one stat and no fork. First calls that start before the
# marker exists each sync, and every write is a temporary file renamed into
# place, so they converge. A call killed mid-sync leaves its marker; an old
# trampoline it did not reach still runs the tool, and the next `uv tool`
# command or `uvm trampolines` rewrites it.
if [[ ! -e "${uvm_heal_marker}" ]] \
   && { [[ -d "${uvm_root_bin}" ]] || (umask 077; mkdir -p "${uvm_root_bin}") 2>/dev/null; } \
   && : 2>/dev/null > "${uvm_heal_marker}"; then
  uvm_trampolines || true
fi

# Off, the common case on every call, is this one builtin test and no fork.
# It sits after uvm_export_env because the repair's uv inherits those paths,
# and ahead of every branch, so the knob fires whatever the subcommand.
if [[ -n "${UVM_REPAIR:-}" && "${UVM_REPAIR}" != 0 ]]; then uvm_repair; fi

if [[ "${uvm_cmd}" == "self" && "${uvm_subcmd}" == "update" ]]; then
  uvm_self_update ${uvm_rest[@]+"${uvm_rest[@]}"}
fi

# Commands that change what is installed also change what needs a trampoline,
# so these cannot be exec'd; they run to completion and then resync. A `uv
# tool` command that changes what is installed also changes the records,
# which only an exit 0 may touch: the marks taken before it say which tools
# it changed. Nothing after uv's own exit overwrites rc.
if [[ "${uvm_cmd}" == "tool" || "${uvm_cmd}" == "python" ]]; then
  uvm_marks="" uvm_recorded_cmd=""
  if [[ "${uvm_cmd}" == "tool" ]]; then
    case "${uvm_subcmd}" in
      install|upgrade|uninstall)
        uvm_recorded_cmd="${uvm_subcmd}"
        uvm_marks="$(uvm_tool_marks)" || true ;;
    esac
  fi
  set +e
  "${real_uv}" "$@"
  rc=$?
  set -e
  if [[ "${rc}" == 0 && -n "${uvm_recorded_cmd}" ]]; then
    uvm_records_update "${uvm_recorded_cmd}" "${uvm_marks}" ${uvm_rest[@]+"${uvm_rest[@]}"} || true
  fi
  # Any `uv tool` command that succeeds also records each installed tool that
  # has no record, so the first `uv tool list` after an upgrade records the
  # tools installed before it.
  if [[ "${rc}" == 0 && "${uvm_cmd}" == "tool" ]]; then uvm_backfill || true; fi
  uvm_trampolines || true
  exit "${rc}"
fi

# None of the execs below can run the EXIT trap, so release ahead of all
# three. The repair above takes its lock this late in the path and releases
# it before it returns, so this is a guard and not the release; it keeps a
# lock from surviving the exec should that ever change, and on a path holding
# none it is one builtin test and no fork. The tool and python path above
# returns normally and stays covered by the trap.
uvm_unlock

case "${mode}" in
  uvx)
    if [[ -x "${real_uvx}" ]]; then
      exec "${real_uvx}" "$@"
    else
      exec "${real_uv}" tool run "$@"
    fi
    ;;
  *)
    exec "${real_uv}" "$@"
    ;;
esac
