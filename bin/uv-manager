#!/usr/bin/env bash
#
# uv-manager — transparent, quota-safe, arch-aware launcher for `uv`/`uvx`
# on heterogeneous HPC clusters.
#
# This file is the real script. Deploy centrally, e.g.:
#   /apps/external/uv/main/bin/uv-manager        the script
#   /apps/external/uv/main/bin/{uv,uvx,uvm}      symlinks to it
# Do NOT put this at ~/.local/bin/uv — that's the standalone installer's
# default UV_INSTALL_DIR, and this would silently overwrite a user's own
# real uv binary if one is already there. Keep this path disjoint and make
# it opt-in (module load / explicit PATH addition), never default PATH.
#
# Real uv payload (binary, cache, tool venvs, managed pythons) never touches
# home quota — it lives under $UVM_ROOT/<arch>/ instead.
#
# See README.md for the design rationale.

set -euo pipefail

readonly uvm_version="0.6.1"

# ---- identity: uv, uvx or uv-manager, decided purely by argv[0] ------------
#
# Real uv does the same thing, so `uvx` needs no separate code path. Dispatch
# keys on the name used to invoke the script, not on whether that name is a
# symlink: a copy named `uvx` still runs in uvx mode.
#
# Anything not recognised falls through to uv mode.

prog="${0##*/}"
case "${prog}" in
  uvx)              mode="uvx"     ;;
  uv-manager|uvm)   mode="manager" ;;
  *)                mode="uv"      ;;
esac

# ---- diagnostics -----------------------------------------------------------

note() { printf 'uv-manager: %s\n' "$*" >&2; }
die()  { printf 'uv-manager: %s\n' "$*" >&2; exit 1; }

# Resolve a path to an absolute, symlink-free form without requiring GNU
# readlink -f or realpath (absent on some minimal images and on macOS).
abspath() {
  local p="$1" d b
  d="$(dirname -- "${p}")"
  b="$(basename -- "${p}")"
  # The empty CDPATH prefix is deliberate: with CDPATH set, `cd` prints the
  # directory it chose, which would end up in the output.
  # shellcheck disable=SC1007
  printf '%s/%s\n' "$(CDPATH= cd -- "${d}" 2>/dev/null && pwd -P)" "${b}"
}

# ---- state root ------------------------------------------------------------
#
# UVM_ROOT is the single knob a site is expected to set, normally from
# its modulefile, where it is visible in `module show uv` and in the user's
# environment. It is architecture-NEUTRAL on purpose: the arch component is
# appended here, at exec time, on the executing node, so a modulefile
# evaluated on an x86_64 login node can safely be inherited by an aarch64
# compute node via `sbatch --export=ALL`.
#
# The cascade below exists only for when the variable is absent — the module
# was not loaded and the wrapper was invoked by absolute path, which is the
# normal case for automation (a Globus Compute user endpoint, a systemd user
# unit, `sbatch --export=NONE`).
#
# There is no /tmp fallback. Node-local storage would turn a configuration
# problem into per-node re-downloads, a cold cache on every job, an egress
# requirement on every node, and environments that disappear at job end.

# Candidate bases, in order of preference. `.uv` is appended to the winner.
readonly uvm_candidates=(
  CLUSTER_SCRATCH   # Purdue RCAC
  RCAC_SCRATCH      # Purdue RCAC, community clusters
  SCRATCH           # Anvil, TACC, NERSC, many others
  PSCRATCH          # NERSC Perlmutter
  WORK              # TACC, Anvil (not purged — often the better choice)
  PROJECT           # Anvil
)

uvm_resolve_root() {
  if [[ -n "${UVM_ROOT:-}" ]]; then
    uvm_base="${UVM_ROOT}"
    uvm_base_origin="UVM_ROOT"
    return 0
  fi

  local name value
  for name in "${uvm_candidates[@]}"; do
    value="${!name:-}"
    [[ -n "${value}" ]] || continue
    [[ -d "${value}" && -w "${value}" ]] || continue
    uvm_base="${value}/.uv"
    uvm_base_origin="\$${name}"
    return 0
  done

  # Nothing resolved. Report every candidate tried and how to fix it.
  {
    printf 'uv-manager: cannot determine where to keep per-user uv state.\n\n'
    printf '  UVM_ROOT is unset, and none of these named an existing,\n'
    printf '  writable directory:\n\n'
    for name in "${uvm_candidates[@]}"; do
      value="${!name:-}"
      if [[ -z "${value}" ]]; then
        printf '      $%-16s (unset)\n' "${name}"
      elif [[ ! -d "${value}" ]]; then
        printf '      $%-16s %s (not a directory)\n' "${name}" "${value}"
      else
        printf '      $%-16s %s (not writable)\n' "${name}" "${value}"
      fi
    done
    printf '\n  Fix by loading the site module:\n'
    printf '      module load uv\n\n'
    printf '  or by setting it explicitly — for automation and batch contexts\n'
    printf '  that do not inherit a login shell, do this in the job script or\n'
    printf '  endpoint configuration:\n'
    printf '      export UVM_ROOT=/path/to/large/scratch/.uv\n\n'
    printf '  This must be on storage visible from every node that will run uv,\n'
    printf '  at the same path, and it must not be your home directory.\n'
  } >&2
  exit 1
}

uvm_base=""
uvm_base_origin=""

# ---- platform key ----------------------------------------------------------
#
# `uname -m` is the right granularity for the uv binary and for uv-managed
# CPython builds, and it is cheap. It runs on every invocation, including
# inside loops that call `uv run` thousands of times. Sites needing a finer
# split (glibc skew between login and compute images, musl, x86-64
# microarchitecture levels) should override it and keep it just as cheap.
#
# Deferred into a function rather than run at load time, so that `help` and
# `--version` still work on a node with no state root configured. Otherwise
# the one command that tells you how to set UVM_ROOT is the one command
# you cannot run without it.
#
# The generated trampolines resolve this same expression in their own /bin/sh
# body (see uvm_trampolines); the two languages share no code, so it is
# written twice on purpose. Both copies must move together — when they
# disagree, a tool is installed under one key and looked for under another,
# and every trampoline exits 127 naming a key the wrapper never used.

uvm_init() {
  uvm_resolve_root
  arch="${UVM_PLATFORM:-$(uname -m)}"
  uvm_root="${uvm_base}/${arch}"
  uvm_versions="${uvm_root}/versions"
  uvm_current="${uvm_root}/current"
  real_uv="${uvm_current}/uv"
  real_uvx="${uvm_current}/uvx"
  # Architecture-neutral trampoline directory. Safe for a modulefile to put on
  # PATH because it has no architecture in its path; see uvm_trampolines.
  uvm_neutral_bin="${uvm_base}/bin"
}

# ---- knobs -----------------------------------------------------------------

pin="${UVM_PIN:-}"
lock_timeout="${UVM_LOCK_TIMEOUT:-180}"
lock_stale="${UVM_LOCK_STALE:-600}"
install_base_url="${UVM_INSTALL_URL:-https://astral.sh/uv}"

# ---- provisioning lock -----------------------------------------------------
#
# mkdir is atomic on Lustre, GPFS and NFS, needs no helper binary, and does
# not depend on flock — which uv itself requires but which is not enabled on
# every parallel filesystem.

uvm_lock=""
uvm_lock_owner=""
uvm_lock_beat_pid=""

# Absolute start time of a pid, or empty when it cannot be determined. A pid
# is a number the kernel reuses, not an identity; pairing it with a start time
# is what distinguishes a process from whatever later inherits its number.
# lstart is not POSIX but is carried by both the BSD and procps ps, in the
# same spirit as the stat -c / stat -f pair.
uvm_proc_start() {
  ps -o lstart= -p "$1" 2>/dev/null || true
}

# Refresh the lock's mtime for as long as the holder lives, so a hold longer
# than UVM_LOCK_STALE is not mistaken for an abandoned one. The bytes written
# are the ones recorded at acquisition, never the current time: identity is
# fixed at acquire and freshness lives entirely in the mtime, so a holder can
# never become foreign to itself.
uvm_lock_heartbeat() {
  local lock="$1" beat="$2" started="$3" recorded="" running=""
  # An async subshell resets traps to their default, so this cannot release
  # its parent's lock by exiting. Clearing them says so out loud, because the
  # cost of being wrong is a refresher deleting the live lock it exists to
  # protect.
  trap - EXIT INT TERM
  while :; do
    sleep "${beat}"
    # $$ is the holder's pid even in here, and kill is a builtin. A pipe
    # leash would be stronger and is unavailable at the portability floor:
    # bash 3.2 returns 1 from `read -t` for both a timeout and EOF, so a
    # leashed refresher cannot tell the interval elapsing from its parent
    # dying.
    kill -0 "$$" 2>/dev/null || return 0
    # kill -0 answered for a pid number, so it cannot tell the holder from
    # whatever reoccupied its number — and pid space wraps in under a minute
    # on a node spawning `uv run` in a loop, against a beat a tenth of the
    # stale threshold. A holder killed without running its traps would
    # otherwise leave this refresher rewriting owner forever: the age net
    # never fires because the mtime keeps moving, the waiter's own probe
    # never fires because it finds the reoccupying process alive, and the
    # lock is left for a human to clear. Both readings must be non-empty to
    # forfeit, so a ps that cannot answer costs a live holder nothing.
    running="$(uvm_proc_start "$$")"
    [[ -z "${started}" || -z "${running}" || "${running}" == "${started}" ]] || return 0
    # Re-read before writing. If the lock were broken and retaken at this
    # path, stamping our identity over the new holder's owner file would stop
    # that holder from ever releasing its own lock — an immortal lock
    # manufactured by the ownership fix itself.
    recorded=""
    read -r recorded 2>/dev/null < "${lock}/owner" || true
    [[ "${recorded}" == "${uvm_lock_owner}" ]] || return 0
    printf '%s\n' "${uvm_lock_owner}" > "${lock}/owner" 2>/dev/null || return 0
  done
}

# Release only what this process still owns. A lock is addressed by path, so
# a holder whose lock was broken as stale deletes whatever the breaker put
# there if release matches on the path alone — mutual exclusion gone while
# both processes are still running.
uvm_unlock() {
  [[ -n "${uvm_lock}" ]] || return 0
  local lock="${uvm_lock}" mine="${uvm_lock_owner}" beat="${uvm_lock_beat_pid}" recorded=""
  # Clear before deciding. The EXIT trap runs after the INT handler's
  # exit 130, so a second pass has to be one builtin test and no fork — which
  # is also what keeps a release in front of an exec free on the hot path.
  uvm_lock=""
  uvm_lock_owner=""
  uvm_lock_beat_pid=""
  # Reap the refresher before reading owner, and wait rather than kill alone.
  # Without the wait bash reports `Terminated: 15` and the whole subshell body
  # on stderr, and the refresher can recreate owner between the rm -f and the
  # rmdir, leaving a directory that rmdir then refuses.
  if [[ -n "${beat}" ]]; then
    kill "${beat}" 2>/dev/null || true
    wait "${beat}" 2>/dev/null || true
  fi
  # 2>/dev/null precedes the input redirect because redirections are applied
  # left to right; the other order lets the failed open reach the user's
  # stderr. Branch on the string and never on read's status: a file with no
  # trailing newline returns 1 with the data assigned. Absent, empty,
  # truncated, unreadable and foreign therefore collapse into one verdict,
  # leave it — a false leave is reclaimed by the stale breaker, a false
  # delete is bounded by nothing.
  read -r recorded 2>/dev/null < "${lock}/owner" || true
  if [[ "${recorded}" == "${mine}" ]]; then
    rm -f "${lock}/owner" 2>/dev/null || true
    # rmdir refusing a non-empty directory is a second guard on the interval
    # between the comparison and the unlink, and it is worth more than the
    # one fork `rm -rf` would save.
    rmdir "${lock}" 2>/dev/null || true
  else
    note "provisioning lock is no longer ours, leaving it in place: ${lock}"
  fi
}

# Release on signals too, not just on a normal return. A RETURN trap alone
# leaves the lock behind when the holder is killed, and a leaked lock blocks
# every later invocation for that user until someone removes it by hand.
trap 'uvm_unlock' EXIT
trap 'uvm_unlock; exit 130' INT
trap 'uvm_unlock; exit 143' TERM

# Age of a path in seconds, or empty if it cannot be determined.
uvm_age() {
  local path="$1" mtime now
  mtime="$(stat -c %Y "${path}" 2>/dev/null || stat -f %m "${path}" 2>/dev/null || true)"
  [[ -n "${mtime}" ]] || return 1
  now="$(date +%s)"
  printf '%s\n' "$(( now - mtime ))"
}

uvm_acquire_lock() {
  local want="$1" force="$2"
  local lock="${uvm_root}/.install.lock"
  local waited=0 age holder pid broke="" reason absent=0 robbed=0 host started still
  # uname -n, not HOSTNAME, which bash leaves at whatever it inherited. A
  # container image that sets it, or a login-node value carried out by
  # `sbatch --export=ALL`, gives two nodes one name — and the host token is
  # what decides whether a recorded pid may be probed locally, so a collision
  # has a waiter probe a pid that lives on the other node, find it absent,
  # and break a live holder's lock on its first iteration. One fork, on the
  # provisioning path only.
  host="$(uname -n)"
  # Our own start time, read here for the same reason as the host token: it
  # is what lets the refresher tell this process from a later one wearing its
  # pid, and both forks belong above the loop rather than inside the window
  # the owner write has to close.
  started="$(uvm_proc_start "$$")"
  # Built before the mkdir, from expansions only. Two command substitutions
  # here left the directory standing with no owner file for 3.0 ms rather
  # than 0.10 ms, and that gap is the only interval in which a stale release
  # can destroy a live lock. The nonce is not decoration: pid space wraps in
  # under a minute on a node spawning `uv run` in a loop, well inside a 600s
  # stale window, so host and pid alone can name a live foreign holder.
  local owner="host=${host} pid=$$ nonce=${RANDOM}${RANDOM}${RANDOM}"

  # The knobs are read here and nowhere else, so the guard sits against the
  # code it protects. Inside the function is also what keeps `uvm help` and
  # `uvm --version` answering on a misconfigured node: the one command that
  # tells an operator how to fix a configuration must not be the command that
  # configuration stops them running.
  #
  # Form first. On bash 3.2 a non-numeric value makes the comparison fatal
  # under `set -u`, and the EXIT trap's own status then overrides the error's,
  # so the script exits 0 — a bare ordering test would turn
  # `VER=$(uv --version)` into empty and true. It also catches ' ' and -1. A
  # stale of 0 is digits and reaches the ordering test below instead, which
  # refuses it whatever the timeout, no timeout being less than zero.
  if [[ ! "${lock_timeout}" =~ ^[0-9]+$ || ! "${lock_stale}" =~ ^[0-9]+$ ]]; then
    die "UVM_LOCK_TIMEOUT and UVM_LOCK_STALE must be whole numbers of seconds.
    UVM_LOCK_TIMEOUT=${lock_timeout}  UVM_LOCK_STALE=${lock_stale}"
  fi
  # Then base 10, onto the same globals the age test and the timeout message
  # read, so all three mean the seconds the operator wrote. Bash reads a
  # leading zero as octal: 0600 is 384, and 0800 is not a number at all —
  # which passes the form test, then makes the comparison error non-fatally
  # and accept. Normalizing cannot come first: `$(( 10# ))` on an empty or
  # all-space value is silently 0 on bash 3.2 and an error on 5.2.
  lock_timeout=$(( 10#${lock_timeout} ))
  lock_stale=$(( 10#${lock_stale} ))
  if (( lock_timeout >= lock_stale )); then
    die "UVM_LOCK_TIMEOUT must be less than UVM_LOCK_STALE.
    UVM_LOCK_TIMEOUT=${lock_timeout}  UVM_LOCK_STALE=${lock_stale}
    A waiter that outlives the stale threshold breaks the lock it is waiting
    for while the process holding it is still running. Lower the timeout or
    raise the stale threshold."
  fi

  (umask 077; mkdir -p "${uvm_root}") \
    || die "cannot create ${uvm_root} — is ${uvm_base} writable?"

  while :; do
    if mkdir "${lock}" 2>/dev/null; then
      # Ownership is certain the instant mkdir returns. Recording it has to
      # precede setting uvm_lock: set that first and die, and the EXIT trap
      # reads an absent owner, declines ownership, and leaks the lock anyway.
      if printf '%s\n' "${owner}" > "${lock}/owner"; then
        break
      fi
      # A failed redirect hands the shell no errno, so the directory is the
      # only evidence of which failure this was. Still standing means the
      # write itself was refused — a mode, a quota, a full filesystem — and
      # that is fatal: a holder unable to prove ownership can never release
      # its own lock and leaks it for a full stale window. The shell's own
      # diagnostic carries the errno that names the fault, which is why the
      # redirect keeps its order; 2>/dev/null in front of it would suppress
      # that message on the fatal path as well as on this one.
      if [[ -d "${lock}" ]]; then
        rmdir "${lock}" 2>/dev/null || true
        die "cannot record ownership of the provisioning lock at ${lock}/owner"
      fi
      # Gone means we won the lock and a losing stale-breaker removed it
      # underneath us before we could claim it. That rank has done nothing
      # wrong, and dying leaves VER=$(uv --version) empty and true on a cold
      # node, so take the lock again. The bound is a literal for the same
      # reason the absent count below is one, and it never resets: three
      # robberies add three fast iterations to the wait rather than letting
      # an alternation of robbery and retry escape the timeout accounting.
      robbed=$(( robbed + 1 ))
      (( robbed >= 3 )) || continue
      die "cannot hold the provisioning lock at ${lock}
    won it ${robbed} times and each time the directory was removed before
    ownership could be recorded. Something is breaking locks it does not own —
    look for a clock skew across nodes making live locks read as stale."
    fi
    # Why mkdir failed cannot be settled by looking again: it can fail EEXIST
    # and the holder release before this test runs, and then a lock that was
    # merely released reads as an unwritable filesystem and the rank dies one
    # iteration from winning. Measured at 2-4% of ranks in 64-way cold
    # bursts, on GPFS and on APFS alike. Persistence decides it instead.
    # Three absences in one wait is a broken mount rather than a race, and
    # that is not a number a site tunes, so it is a literal and not another
    # knob. The count never resets, which holds the iterations it can add
    # to three however the loop alternates.
    if [[ ! -d "${lock}" ]]; then
      absent=$(( absent + 1 ))
      (( absent >= 3 )) || continue
      die "cannot create provisioning lock at ${lock} — check permissions and quota on ${uvm_base}"
    fi

    # Someone else may have finished the work we were about to do. This must
    # test the version we were actually asked for: testing merely "is some uv
    # present" silently hands a pinned caller whatever the other process was
    # installing, which is the one guarantee a pin exists to provide.
    if [[ -z "${force}" ]] && uvm_have "${want}"; then
      return 1
    fi

    # Liveness is the fast path, not the only evidence. A holder on this node
    # whose pid is gone loses its lock immediately instead of waiting out the
    # stale window; everything else is decided by age below.
    holder=""
    read -r holder 2>/dev/null < "${lock}/owner" || true
    pid=""
    if [[ "${holder%% *}" == "host=${host}" ]]; then
      pid="${holder#*pid=}"
      pid="${pid%% *}"
      # A non-numeric pid makes kill -0 fail and would read as a dead holder,
      # which is a break with no evidence behind it.
      [[ -n "${pid}" && -z "${pid//[0-9]/}" ]] || pid=""
    fi

    # A lock is forfeit two ways — a dead holder on this node, or an age no
    # heartbeat has touched — and both are broken the same way, so they are
    # decided here and acted on once below.
    reason=""
    if [[ -n "${pid}" ]] && ! kill -0 "${pid}" 2>/dev/null; then
      reason="breaking provisioning lock abandoned by a dead process"
    # Age is consulted whatever the probe answered. kill -0 answers for a pid
    # number, not for the process that recorded it, and the number is reused:
    # gated behind a negative probe, a lock left by a killed holder becomes
    # unbreakable for the lifetime of whatever inherits its pid, which is a
    # leak only a human clears. A live holder is protected by its heartbeat
    # rather than by this branch never running — ten beats fit inside the
    # threshold, so a hold stays an order of magnitude short of it however
    # long the work takes. The age comes from the file because a directory's
    # mtime tracks its entry list rather than writes to files inside it, so on
    # the directory the heartbeat is invisible. The directory remains the
    # fallback for a lock an older wrapper wrote, or one caught inside the
    # acquire window.
    elif { age="$(uvm_age "${lock}/owner")" || age="$(uvm_age "${lock}")"; } \
         && (( age > lock_stale )); then
      reason="breaking stale provisioning lock (${age}s old)"
    fi

    if [[ -n "${reason}" ]]; then
      # A break note names the owner it deleted. Ownership makes "whose lock
      # was that" the first question asked after a break, and the file that
      # answers it is gone by the time anyone reads the note. Announced once:
      # a break that keeps being denied repeats every second, which at the
      # default timeout is 180 identical lines.
      [[ -n "${broke}" ]] || note "${reason}: ${lock}
    its owner file recorded: ${holder:-<none recorded>}"
      # Re-read immediately before acting. The forfeiture above was decided
      # from a line read up to a second ago, and a directory has no identity
      # a shell can see: another waiter may have broken that instance already
      # and a third won mkdir at the same path, so an unqualified removal
      # deletes a lock this process never judged. Removing the owner file is
      # what makes the directory empty, so gating it also arms rmdir's refusal
      # of a non-empty directory as the second half of the same guard — which
      # is why both calls sit inside the test and not one of them.
      still=""
      read -r still 2>/dev/null < "${lock}/owner" || true
      if [[ "${still}" == "${holder}" ]]; then
        rm -f "${lock}/owner" 2>/dev/null || true
        rmdir "${lock}" 2>/dev/null || true
      fi
      # Re-enter mkdir at once only where the directory is actually gone. A
      # removal denied by an entry we did not write, or by a read-only
      # remount, is charged to the timeout like any other wait; retrying it
      # immediately is a hot loop that UVM_LOCK_TIMEOUT does not bound, on a
      # knob documented as how long a call blocks. Our own rmdir's status is
      # the wrong discriminator — two waiters can declare the same lock
      # forfeit, and the loser gets ENOENT having done nothing wrong.
      [[ -d "${lock}" ]] || continue
      broke=denied
    fi

    waited=$(( waited + 1 ))
    if (( waited > lock_timeout )); then
      # A recorded pid belongs to the host recorded beside it, so a stalled
      # user who probes it here concludes the holder is gone and deletes a
      # live lock. The removal is two steps because owner lives inside the
      # directory: rmdir alone reports Directory not empty for every lock
      # whose holder got as far as claiming it.
      die "timed out after ${lock_timeout}s waiting for provisioning lock: ${lock}
    holder, from the lock's owner file: ${holder:-<none recorded>}
    A pid recorded there is on that host, not this one. If it is gone, remove the lock:
        rm -f '${lock}/owner' && rmdir '${lock}'"
    fi
    sleep 1
  done

  uvm_lock="${lock}"
  uvm_lock_owner="${owner}"
  # Ten beats inside a stale window, scaled to whatever the site configured
  # rather than to a knob of its own. Derived here and not beside lock_stale
  # because the arithmetic is fatal under `set -u` on a non-numeric value,
  # and `uvm help` — which is where these knobs are documented — has to keep
  # answering on a node whose configuration is broken.
  local lock_beat=$(( lock_stale / 10 ))
  (( lock_beat > 0 )) || lock_beat=1
  # Detached, because a surviving background child holds the caller's pipe
  # open and `VER=$(uv --version)` was measured blocking 9s behind one.
  uvm_lock_heartbeat "${lock}" "${lock_beat}" "${started}" >/dev/null 2>&1 &
  uvm_lock_beat_pid=$!
  return 0
}

# ---- fetching --------------------------------------------------------------

uvm_fetch() {
  local url="$1"
  if command -v curl >/dev/null 2>&1; then
    curl -LsSf --retry 3 --retry-connrefused "${url}"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO- --tries=3 "${url}"
  else
    die "neither curl nor wget is available; cannot download uv"
  fi
}

# ---- install ---------------------------------------------------------------

# True when the requested version is on disk; with no version requested, true
# when any uv is selected. The single spelling of "is this request already
# satisfied?", used by the caller, by the lock, and inside uvm_install.
uvm_have() {
  local want="$1"
  if [[ -n "${want}" ]]; then
    [[ -x "${uvm_versions}/${want}/uv" ]]
  else
    [[ -x "${real_uv}" ]]
  fi
}

# Point ${uvm_current} at versions/<ver>. The symlink target is relative so
# the tree stays relocatable, and the swap is atomic so a concurrent reader
# never observes a missing or half-written `current`.
uvm_point_current() {
  local ver="$1" tmp
  [[ "$(readlink -- "${uvm_current}" 2>/dev/null || true)" == "versions/${ver}" ]] && return 0
  tmp="${uvm_root}/.current.$$"
  rm -f "${tmp}" 2>/dev/null || true   # a prior run may have died holding this name
  ln -s "versions/${ver}" "${tmp}"
  if ! mv -T "${tmp}" "${uvm_current}" 2>/dev/null; then
    # mv -T is GNU-only; fall back to a brief non-atomic replace.
    rm -f "${uvm_current}" 2>/dev/null || true
    mv "${tmp}" "${uvm_current}"
  fi
}

uvm_installed_version() {
  local ver
  ver="$("$1" --version 2>/dev/null | awk 'NR==1 {print $2}')" || return 1
  [[ -n "${ver}" ]] || return 1
  printf '%s\n' "${ver}"
}

# uvm_install WANT FORCE
#   WANT   version to install and select; empty means "latest"
#   FORCE  non-empty to go to the network even if WANT is already on disk
#
# Both are parameters rather than globals: the lock's early-out has to know
# which version this particular call is serving.
uvm_install() {
  local want="$1" force="${2:-}"
  local url tmp ver dest

  # Fast path: already on disk, so no lock and no network.
  if [[ -z "${force}" ]] && uvm_have "${want}"; then
    [[ -n "${want}" ]] && uvm_point_current "${want}"
    return 0
  fi

  uvm_acquire_lock "${want}" "${force}" || return 0  # another process got there first

  # Re-check under the lock.
  if [[ -z "${force}" ]] && uvm_have "${want}"; then
    [[ -n "${want}" ]] && uvm_point_current "${want}"
    uvm_unlock
    return 0
  fi

  url="${install_base_url}/install.sh"
  [[ -n "${want}" ]] && url="${install_base_url}/${want}/install.sh"

  mkdir -p "${uvm_versions}"
  tmp="$(mktemp -d "${uvm_versions}/.incoming.XXXXXXXX")"

  note "installing uv (${want:-latest}) for ${arch}"

  # UV_INSTALL_DIR and CARGO_DIST_FORCE_INSTALL_DIR are checked by install.sh
  # BEFORE UV_UNMANAGED_INSTALL and take precedence over it. If a user has
  # either exported, uv lands somewhere else entirely, the binary we expect
  # never appears, and every subsequent invocation re-runs the installer and
  # fails. Scrub them. Mirror-related variables are left alone: they only
  # redirect where the tarball comes from, which is legitimate site policy.
  #
  # The installer's progress output goes to stderr, not stdout. Provisioning
  # is a side effect of whatever the user actually asked for, and on a cold
  # node `VER=$(uv --version)` must not come back with four lines of installer
  # chatter ahead of the answer.
  if ! uvm_fetch "${url}" \
        | env -u UV_INSTALL_DIR -u CARGO_DIST_FORCE_INSTALL_DIR \
              UV_UNMANAGED_INSTALL="${tmp}" sh >&2; then
    rm -rf "${tmp}" 2>/dev/null || true
    uvm_unlock
    die "install failed — no egress from this node?
    Pre-warm from a node of this architecture (${arch}) that has outbound
    HTTPS, then retry here. Any uv command will do:  uv --version"
  fi

  if ! ver="$(uvm_installed_version "${tmp}/uv")"; then
    rm -rf "${tmp}" 2>/dev/null || true
    uvm_unlock
    die "installed uv is not runnable on this node (${arch}) — wrong architecture?"
  fi

  dest="${uvm_versions}/${ver}"
  if [[ -d "${dest}" ]]; then
    rm -rf "${tmp}" 2>/dev/null || true   # already had this version
  else
    mv "${tmp}" "${dest}"                 # atomic rename within versions/
  fi
  uvm_point_current "${ver}"
  uvm_unlock
}

# A pin is honoured even when some other version is already installed: it
# selects which version `current` points at, not merely which version to
# download if nothing is present.
uvm_ensure_uv() {
  if uvm_have "${pin}"; then
    if [[ -n "${pin}" ]]; then uvm_point_current "${pin}"; fi
  else
    uvm_install "${pin}" ""
  fi

  [[ -x "${real_uv}" ]] || die "uv is still missing after provisioning: ${real_uv}"
}

# ---- storage layout --------------------------------------------------------

# The storage layout, defined once. Everything else reads these variables
# rather than rebuilding the same paths, so adding a directory is a one-line
# change here. Pure: sets variables, touches no filesystem, so the read-only
# subcommands can call it without provisioning anything.
uvm_set_paths() {
  export UV_CACHE_DIR="${uvm_root}/cache"
  export UV_TOOL_DIR="${uvm_root}/tools"
  export UV_TOOL_BIN_DIR="${uvm_root}/bin/shims"
  export UV_PYTHON_INSTALL_DIR="${uvm_root}/python"
  export UV_PYTHON_BIN_DIR="${uvm_root}/bin/python-shims"

  # XDG_CONFIG_HOME is left alone on purpose: that's where a user's own
  # ~/.config/uv/uv.toml (index URLs, auth, mirrors) lives, and hiding it
  # would change resolution behaviour, not just storage location. It is also
  # where the standalone installer looks for its receipt.
}

uvm_export_env() {
  uvm_set_paths

  # Guarded, not unconditional. Resolving six directories that already exist
  # costs a fork, an exec, and — under GNU coreutils — one EEXIST-failing
  # mkdir(2) per path component of every operand, so the syscall count grows
  # with the depth of UVM_ROOT and a scratch path is deep. Measured at 2 ms of
  # a 12 ms invocation, on the path `uv run` takes inside loops that call it
  # thousands of times, issued by every rank of a job at once against a single
  # metadata server. Six builtin tests cost 15 us and spawn nothing.
  #
  # The test stays outside the subshell. Moved inside, the fork survives and a
  # third of the saving goes with it.
  #
  # A missing directory is still created, under umask 077. That is the half of
  # the old unconditional call that was load-bearing — it restores the shape of
  # a tree a scratch purge has partially removed. It does not repair modes:
  # mkdir -p never chmods a directory that already exists, so the property is
  # "directories we create are 0700", not "our directories are 0700".
  if [[ ! -d "${UV_CACHE_DIR}" || ! -d "${UV_TOOL_DIR}" || ! -d "${UV_TOOL_BIN_DIR}" \
     || ! -d "${UV_PYTHON_INSTALL_DIR}" || ! -d "${UV_PYTHON_BIN_DIR}" \
     || ! -d "${uvm_neutral_bin}" ]]; then
    (
      umask 077
      mkdir -p "${UV_CACHE_DIR}" "${UV_TOOL_DIR}" "${UV_TOOL_BIN_DIR}" \
               "${UV_PYTHON_INSTALL_DIR}" "${UV_PYTHON_BIN_DIR}" "${uvm_neutral_bin}"
    )
  fi

  # Both the arch-specific shim dirs (correct for this node, for anything we
  # exec) and the arch-neutral trampoline dir (correct everywhere, and what
  # the modulefile puts on PATH).
  #
  # Prepended idempotently: the exported PATH is inherited by everything uv
  # spawns, and anything that re-enters the wrapper would otherwise add the
  # same three entries again at every level of nesting.
  uvm_path_prepend "${uvm_neutral_bin}"
  uvm_path_prepend "${UV_PYTHON_BIN_DIR}"
  uvm_path_prepend "${UV_TOOL_BIN_DIR}"
  export PATH
}

uvm_path_prepend() {
  case ":${PATH}:" in
    *":$1:"*) return 0 ;;
  esac
  PATH="$1:${PATH}"
}

# ---- architecture-neutral trampolines --------------------------------------
#
# `uv tool install ruff` drops an executable in a per-architecture directory.
# That directory cannot go on PATH from a modulefile, because a modulefile is
# evaluated on the login node and inherited by compute nodes of a different
# architecture. So instead we maintain one neutral directory of tiny shell
# trampolines that re-resolve the platform key at exec time.
#
# The body resolves that key the way uvm_init does, on the executing node and
# from the invoker's environment. See the platform-key banner: the expression
# is duplicated across two languages and both copies must move together.
#
# Trampolines are generated for the union of names across all architectures,
# so invoking a tool on an architecture where it is not installed reports
# that, instead of failing with "Exec format error".

readonly uvm_tramp_marker="# uv-manager-trampoline"

uvm_trampolines() {
  local names name f tmp

  [[ -d "${uvm_base}" ]] || return 0
  mkdir -p "${uvm_neutral_bin}" 2>/dev/null || return 0

  names="$(
    for d in "${uvm_base}"/*/bin/shims "${uvm_base}"/*/bin/python-shims; do
      [[ -d "${d}" ]] || continue
      for f in "${d}"/*; do
        [[ -e "${f}" || -L "${f}" ]] || continue
        basename -- "${f}"
      done
    done | sort -u
  )"

  # Rewrite every trampoline we own rather than skipping any name that already
  # exists: one truncated by a purge, or written by an older uv-manager, has to
  # be repaired, and skipping on mere existence means it never is. A file that
  # is non-empty, executable and unmarked is somebody's own script that happens
  # to share the name; leave it, and say so.
  local dest
  while IFS= read -r name; do
    [[ -n "${name}" ]] || continue
    dest="${uvm_neutral_bin}/${name}"
    if [[ -e "${dest}" || -L "${dest}" ]] \
       && ! grep -q "${uvm_tramp_marker}" "${dest}" 2>/dev/null \
       && [[ -s "${dest}" && -x "${dest}" ]]; then
      note "not overwriting ${dest} (not generated by uv-manager)"
      continue
    fi
    tmp="${uvm_neutral_bin}/.${name}.$$"
    cat > "${tmp}" <<TRAMPOLINE
#!/bin/sh
${uvm_tramp_marker} — generated; edits will be lost.
n=\${0##*/}
d=\$(CDPATH= cd -- "\$(dirname -- "\$0")/.." && pwd -P)
a=\${UVM_PLATFORM:-\$(uname -m)}
for s in shims python-shims; do
    t="\$d/\$a/bin/\$s/\$n"
    if [ -x "\$t" ]; then exec "\$t" "\$@"; fi
done
echo "uv-manager: '\$n' is not installed for architecture '\$a'." >&2
echo "uv-manager: it exists for another architecture; install it here with" >&2
echo "uv-manager:     uv tool install <package>" >&2
exit 127
TRAMPOLINE
    chmod 0755 "${tmp}"
    mv -f "${tmp}" "${uvm_neutral_bin}/${name}"
  done <<< "${names}"

  # Remove trampolines whose target no longer exists anywhere. Only ever
  # touch files we generated.
  for f in "${uvm_neutral_bin}"/*; do
    [[ -f "${f}" ]] || continue
    grep -q "${uvm_tramp_marker}" "${f}" 2>/dev/null || continue
    name="$(basename -- "${f}")"
    printf '%s\n' "${names}" | grep -qxF "${name}" || rm -f "${f}"
  done
}

# ---- argument inspection ---------------------------------------------------
#
# Find the first positional argument, skipping uv's global options and the
# values of those that take one. Used only to recognise `self update` and the
# tool/python commands; everything else is passed through untouched.
#
# The list below is deliberately short. uv's *global* options that take a
# separate value are these five; everything else that looks like one (--python,
# --index-url, --cache-dir, ...) is a per-command option and can only appear
# after the subcommand, where this parser has already stopped looking. A longer
# list is not more careful — it is more surface to drift out of date and more
# arguments to mis-skip.

uvm_global_takes_value() {
  case "$1" in
    --color|--allow-insecure-host|--directory|--project|--config-file) return 0 ;;
    *) return 1 ;;
  esac
}

# Sets uvm_cmd, uvm_subcmd, and uvm_rest (everything after the subcommand).
uvm_parse_command() {
  uvm_cmd=""
  uvm_subcmd=""
  uvm_rest=()
  local seen=0
  while (( $# )); do
    if [[ "$1" == -* ]]; then
      # `shift 2` is all-or-nothing in bash: with one argument left it shifts
      # nothing and returns non-zero, so a trailing value-taking flag would
      # spin this loop forever. Guard on the count instead of swallowing the
      # failure. uv itself will report the missing value.
      if uvm_global_takes_value "$1" && (( $# >= 2 )); then shift 2; else shift; fi
      continue
    fi
    if (( seen == 0 )); then uvm_cmd="$1"; seen=1; shift; continue; fi
    uvm_subcmd="$1"
    shift
    uvm_rest=( ${1+"$@"} )
    return 0
  done
}

# ---- `uv self update` interception -----------------------------------------
#
# The wrapper's uv is installed with UV_UNMANAGED_INSTALL, which suppresses
# the install receipt, which in turn disables the binary's own self-update
# with an unhelpful message. Turn it into a re-provision of our tree instead.

uvm_self_update() {
  local dry_run="" target="" want_help=""
  while (( $# )); do
    case "$1" in
      -h|--help)  want_help=1 ;;
      --dry-run)  dry_run=1 ;;
      --token)    shift || true ;;   # takes a value; never treat it as a version
      --token=*)  ;;
      -*)         ;;
      *)          target="$1" ;;     # positional TARGET_VERSION
    esac
    shift || true
  done

  if [[ -n "${want_help}" ]]; then
    cat <<EOF
Usage: uv self update [TARGET_VERSION]

Intercepted by uv-manager. Re-provisions this user's uv for ${arch} under
${uvm_root} instead of attempting an in-place self-update, which cannot work
for an unmanaged install.

Options:
  --dry-run    Report what would happen and exit
  -h, --help   Show this message

See also: uv-manager install [VERSION], uv-manager versions
EOF
    exit 0
  fi

  if [[ -n "${dry_run}" ]]; then
    printf 'uv-manager: self update intercepted (dry-run) — would refresh %s\n' "${uvm_root}"
    [[ -n "${target}" ]] && printf 'uv-manager: would install version %s\n' "${target}"
    exit 0
  fi

  note "intercepting 'uv self update' -> re-provisioning ${arch} install at ${uvm_root}"
  # A named version is a request to select that version, downloading it only
  # if absent. No version means "go and find out what latest is now".
  if [[ -n "${target}" ]]; then uvm_install "${target}" ""; else uvm_install "" 1; fi
  # exec replaces the process image, so the EXIT trap never runs and a lock
  # still held here would be leaked until the stale timer fires. uvm_install
  # has already released its own, which makes this a guard rather than the
  # release; on a path holding no lock it is one builtin test and no fork.
  uvm_unlock
  exec "${real_uv}" --version
}

# ---- uv-manager subcommands ------------------------------------------------

# Emitted through a heredoc rather than a series of printfs so that closing
# stdout early (`uv-manager status | head`) behaves like any other Unix filter.
# bash's printf builtin reports EPIPE as "write error: Broken pipe"; `cat` dies
# quietly on SIGPIPE.
uvm_status() {
  local cur resolved
  cur="$( [[ -L "${uvm_current}" ]] && readlink -- "${uvm_current}" 2>/dev/null || true )"
  resolved="$( [[ -x "${real_uv}" ]] && "${real_uv}" --version 2>/dev/null || echo 'n/a' )"
  cat <<EOF
uv-manager:            ${uvm_version}
invoked as:            ${prog}  ($(abspath "$0"))
architecture:          ${arch}
state root:            ${uvm_base}  (from ${uvm_base_origin})
arch root:             ${uvm_root}
selected version:      ${cur:-<none>}
real uv:               ${real_uv} $( [[ -x "${real_uv}" ]] && echo '[present]' || echo '[MISSING]' )
real uvx:              ${real_uvx} $( [[ -x "${real_uvx}" ]] && echo '[present]' || echo '[MISSING]' )
resolved version:      ${resolved}
installed versions:    $(uvm_list_versions | tr '\n' ' ')
UV_CACHE_DIR:          ${UV_CACHE_DIR}
UV_TOOL_DIR:           ${UV_TOOL_DIR}
UV_TOOL_BIN_DIR:       ${UV_TOOL_BIN_DIR}
UV_PYTHON_INSTALL_DIR: ${UV_PYTHON_INSTALL_DIR}
UV_PYTHON_BIN_DIR:     ${UV_PYTHON_BIN_DIR}
trampoline dir:        ${uvm_neutral_bin}
XDG_CONFIG_HOME:       ${XDG_CONFIG_HOME:-<unset — user default: ~/.config>}
pin:                   ${pin:-<none — tracks latest>}
EOF
}

uvm_list_versions() {
  local d
  [[ -d "${uvm_versions}" ]] || return 0
  for d in "${uvm_versions}"/*/; do
    [[ -x "${d}uv" ]] || continue
    basename -- "${d%/}"
  done
}

# Scratch purges are per-file on access time, so a tree can be removed
# piecemeal. uv performs no integrity check on an environment it believes is
# installed; it will exec a half-deleted venv and produce an ImportError.
# Look for the damage uv does not notice.
#
# Two counters, under one rule: a FAIL means the tree does not work and sets
# the exit status; a WARN is information about a tree that does work and does
# not. The rule matters more than the current split, because it tells whoever
# adds the next finding which counter it belongs to. Automation keyed on the
# exit status — a job prologue, which README.md recommends — is the reason
# advice must not fail: a tool that runs perfectly well while missing its
# receipt would otherwise hold the status at 1 until someone deleted it.
#
# Findings accumulate into one string and leave through a single `cat`. Every
# document that sends a user here sends them through a pipe as often as not,
# and on `uvm doctor | head` bash's printf builtin reports `write error:
# Broken pipe` once per finding still queued behind the reader that left.
# `cat` dies quietly. The string is expanded once inside the heredoc and not
# rescanned, so a path containing `$` is data rather than an expansion.
uvm_doctor() {
  local problems=0 advisories=0 findings="" d f target name

  if [[ ! -x "${real_uv}" ]]; then
    findings+="FAIL  uv binary missing: ${real_uv}"$'\n'; problems=$(( problems + 1 ))
  fi

  # Dangling tool/python shims: the target was purged or removed.
  for d in "${uvm_root}/bin/shims" "${uvm_root}/bin/python-shims"; do
    [[ -d "${d}" ]] || continue
    for f in "${d}"/*; do
      [[ -e "${f}" || -L "${f}" ]] || continue
      if [[ ! -x "${f}" ]]; then
        findings+="FAIL  dangling executable: ${f}"$'\n'; problems=$(( problems + 1 ))
      fi
    done
  done

  # Tool environments missing their receipt, their virtualenv marker, or their
  # interpreter.
  if [[ -d "${uvm_root}/tools" ]]; then
    for d in "${uvm_root}/tools"/*/; do
      [[ -d "${d}" ]] || continue
      name="$(basename -- "${d%/}")"
      # Advisory, not damage: uv ignores a receipt-less directory, but whatever
      # is installed there keeps working when invoked. The line carries its own
      # remedy because a tree with no failures prints no remediation block, and
      # the remedy is --force because the receipt is also what records the
      # entrypoints: a plain reinstall exits 2 on the surviving shim, and
      # deleting the directory alone strands it into a dangling-executable
      # failure this same run would report next time.
      if [[ ! -f "${d}uv-receipt.toml" ]]; then
        findings+="WARN  tool ${name} has no receipt; uv ignores it."
        findings+=" Rebuild it with uv tool install --force ${name},"
        findings+=" or delete the directory and its shim."$'\n'
        advisories=$(( advisories + 1 ))
      fi
      # pyvenv.cfg is what marks the directory as a virtualenv. Without it uv
      # resolves the base interpreter instead, and a repair aimed at this tool
      # installs into that interpreter's site-packages — outside the tree the
      # wrapper owns, and on a shared image outside the user's control. Say so
      # in the finding: this is the one class where the obvious next move is
      # worse than the damage.
      if [[ ! -f "${d}pyvenv.cfg" ]]; then
        findings+="FAIL  tool ${name} has no pyvenv.cfg; no automated repair is safe for it"$'\n'
        problems=$(( problems + 1 ))
      fi
      target="${d}bin/python"
      if [[ -e "${target}" || -L "${target}" ]] && [[ ! -x "${target}" ]]; then
        findings+="FAIL  tool ${name} has a broken interpreter link"$'\n'
        problems=$(( problems + 1 ))
      fi
    done
  fi

  # Files missing from inside an environment. uv does not catch this: with a
  # valid receipt it assumes the environment is intact and execs it, and the
  # user gets an ImportError from Python rather than a re-provision. The walk
  # is driven from the dist-info directory rather than the RECORD inside it,
  # because RECORD is read only on uninstall — the coldest file in a
  # distribution, and so an early casualty of an atime-ordered purge. A
  # manifest that is itself gone has to be a finding; globbing for it made the
  # check blind exactly on the trees it exists to catch.
  local di record sp rel missing total
  for di in "${uvm_root}"/tools/*/lib/*/site-packages/*.dist-info; do
    [[ -d "${di}" ]] || continue
    name="${di##*/}"; name="${name%.dist-info}"
    record="${di}/RECORD"
    sp="${di%/*}"
    if [[ ! -f "${record}" ]]; then
      findings+="FAIL  ${name} has no RECORD manifest (partial purge)"$'\n'
      problems=$(( problems + 1 ))
      continue
    fi
    missing=0; total=0
    # `read` returns non-zero on a final line with no trailing newline, and
    # RECORD files like that exist; without the guard the loop discards that
    # entry and the walk goes silent on a damaged distribution. Splitting on
    # every comma truncates a quoted path that contains one — the awk this
    # replaced did the same, and correcting it would move the verdict on real
    # trees.
    while IFS=, read -r rel _ || [[ -n "${rel}" ]]; do
      [[ -n "${rel}" ]] || continue
      rel="${rel#\"}"; rel="${rel%\"}"
      case "${rel}" in ../*|/*) continue ;; esac   # scripts outside site-packages
      total=$(( total + 1 ))
      [[ -e "${sp}/${rel}" ]] || missing=$(( missing + 1 ))
    done < "${record}"
    if (( missing > 0 )); then
      findings+="FAIL  ${name} is missing ${missing} of ${total} files (partial purge)"$'\n'
      problems=$(( problems + 1 ))
    fi
  done

  # Managed interpreters that no longer run.
  if [[ -d "${uvm_root}/python" ]]; then
    for d in "${uvm_root}/python"/*/; do
      [[ -d "${d}" ]] || continue
      name="$(basename -- "${d%/}")"
      for f in "${d}bin/python3" "${d}bin/python"; do
        [[ -x "${f}" ]] || continue
        if ! "${f}" -c 'import json, os, ssl' >/dev/null 2>&1; then
          findings+="FAIL  managed interpreter ${name} is damaged (stdlib import failed)"$'\n'
          problems=$(( problems + 1 ))
        fi
        break
      done
    done
  fi

  # The delimiters below are unquoted because the findings and the counts
  # interpolate, so no body may contain an unescaped `$` of its own.
  if (( problems == 0 )); then
    # The success line has to stay true when advisories were printed above it.
    if (( advisories > 0 )); then
      cat <<EOF
${findings}OK    no damage detected under ${uvm_root} (${advisories} advisory finding(s) above)
EOF
    else
      cat <<EOF
OK    no damage detected under ${uvm_root}
EOF
    fi
    return 0
  fi

  cat <<EOF
${findings}
${problems} problem(s) found. A scratch purge removes files from under a tree uv still
believes is intact, and uv re-checks nothing, so a repair has to bypass its cache:

    uv tool upgrade --all --reinstall --no-cache
    uv python install --reinstall

--no-cache carries the repair: uv runs no integrity check on its unpacked archive
store, so a rebuild that reuses the cache reinstalls the same damage. The python
command needs network access; uv never caches interpreter tarballs. A missing uv
binary needs no command at all — the next uv call re-provisions it and honors
UVM_PIN.

The first command exits 1 on a tool reported above as having no receipt, and says
that tool is not installed. It repairs every other tool before it gets there, so the
failure is about the orphan and not the repair. Deal with that tool the way its own
line says, then run this again.

Neither command repairs a tool whose pyvenv.cfg is gone, and neither is safe to run
against one: uv falls back to the base interpreter and writes outside this tree.
Remove that tool's directory and install the tool again, naming the version you
want — the recorded requirement may not be the version that was installed.

Consider pointing UVM_ROOT at non-purged storage instead.
EOF
  return 1
}

uvm_clean() {
  local what="${1:-cache}" confirm="${2:-}"
  local target
  case "${what}" in
    cache) target="${uvm_root}/cache" ;;
    arch)  target="${uvm_root}" ;;
    all)   target="${uvm_base}" ;;
    *)     die "clean: expected one of: cache, arch, all" ;;
  esac
  if [[ "${confirm}" != "--yes" ]]; then
    # Heredoc rather than printfs, for the same reason as uvm_status: `cat`
    # dies quietly on SIGPIPE where bash's printf reports EPIPE.
    cat <<EOF
Would remove: ${target}
$(du -sh "${target}" 2>/dev/null || echo '(absent)')
Re-run with --yes to proceed.
EOF
    return 0
  fi
  note "removing ${target}"
  rm -rf "${target}"
}

uvm_help() {
  cat <<EOF
uv-manager ${uvm_version} — site launcher for uv on multi-architecture clusters

Usage: uv-manager <command> [args]

  status              Show every resolved path and the selected uv version
  doctor              Check for a partially purged / damaged tree
  versions            List uv versions installed for this architecture
  install [VERSION]   Select VERSION, downloading it if absent.
                      With no VERSION, re-resolve latest from the network.
  trampolines         Regenerate architecture-neutral executable shims
  clean [WHAT] --yes  Remove cache (default), arch tree, or all
  help                This message

Environment:
  UVM_ROOT            Base directory for per-user uv state (set by the module)
  UVM_PIN             uv version to provision and select
  UVM_PLATFORM        Override the architecture key (default: uname -m)
  UVM_INSTALL_URL     Installer base URL, for sites mirroring Astral
  UVM_LOCK_TIMEOUT    Seconds to wait for the provisioning lock (default: 180)
  UVM_LOCK_STALE      Seconds before an untouched lock is broken (default: 600)
                      The timeout must be less than the stale threshold.

'uvm' is a short alias for 'uv-manager'. The same script is also installed as
'uv' and 'uvx', which pass through to the real uv for this node's architecture.
EOF
}

uvm_manager_main() {
  local cmd="${1:-status}"
  shift || true

  # These two are the reason uvm_init is deferred: they must work where no
  # state root is configured, because they are what tell you how to set one.
  case "${cmd}" in
    help|-h|--help) uvm_help; return 0 ;;
    --version)      printf '%s\n' "${uvm_version}"; return 0 ;;
  esac

  uvm_init
  case "${cmd}" in
    status)      uvm_set_paths; uvm_status ;;
    versions)    uvm_list_versions ;;
    doctor)      uvm_set_paths; uvm_doctor ;;
    clean)       uvm_clean "${1:-cache}" "${2:-}" ;;
    trampolines) uvm_export_env; uvm_trampolines
                 note "trampolines synced in ${uvm_neutral_bin}" ;;
    install)     if [[ -n "${1:-}" ]]; then uvm_install "$1" ""; else uvm_install "" 1; fi
                 uvm_export_env; uvm_trampolines
                 note "selected $("${real_uv}" --version 2>/dev/null || echo '?')" ;;
    *)           die "unknown command: ${cmd} (try: uv-manager help)" ;;
  esac
}

# ---- dispatch --------------------------------------------------------------

if [[ "${mode}" == "manager" ]]; then
  uvm_manager_main "$@"
  exit $?
fi

uvm_init

uvm_cmd=""
uvm_subcmd=""
uvm_rest=()
uvm_parse_command "$@"

uvm_ensure_uv
uvm_export_env

if [[ "${uvm_cmd}" == "self" && "${uvm_subcmd}" == "update" ]]; then
  uvm_self_update ${uvm_rest[@]+"${uvm_rest[@]}"}
fi

# Commands that change what is installed also change what needs a trampoline,
# so these cannot be exec'd; they run to completion and then resync.
if [[ "${uvm_cmd}" == "tool" || "${uvm_cmd}" == "python" ]]; then
  set +e
  "${real_uv}" "$@"
  rc=$?
  set -e
  uvm_trampolines || true
  exit "${rc}"
fi

# None of the execs below can run the EXIT trap, so release ahead of all
# three. Nothing acquires the lock this late in the dispatch path today; the
# guard is what keeps the leak impossible when something does. The tool and
# python path above returns normally and stays covered by the trap.
uvm_unlock

case "${mode}" in
  uvx)
    if [[ -x "${real_uvx}" ]]; then
      exec "${real_uvx}" "$@"
    else
      exec "${real_uv}" tool run "$@"
    fi
    ;;
  *)
    exec "${real_uv}" "$@"
    ;;
esac
